<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Vn.App.Views"
        x:Class="Vn.App.MainWindow"
        Width="1400"
        Height="880"
        MinWidth="1000"
        MinHeight="640"
        Title="VnTool">
    <DockPanel>
        <!-- 위아래 여백은 4 — 위 띠 · 탭 줄 · 툴바 세 줄을 붙인다(2026-11-18 소유자 — 「불필요하게 공간을 활용」 · chrome-card-header U1, ⛔ 그 전에는 10). -->
        <Border DockPanel.Dock="Top"
                Padding="12,4"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <Grid x:Name="TopBar" ColumnDefinitions="Auto,16,Auto,Auto,*,Auto">
                <!-- File 메뉴 (2026-11-17 소유자 — 유니티처럼 눌러 목록에서 고른다). 되돌리기 · 다시 실행도 여기 있다(2026-11-18 소유자 —
                     「키보드를 안 쓰는 사람들을 위해서기도 하고, 중요한 기능이니만큼 단축키를 몰라도 사용할 수 있도록」 · finishing FX7) — 메뉴 글
                     옆에 단축키를 적고, 누르면 그 키와 같은 일을 한다. ⛔ 2026-11-17에 위 띠의 [실행 취소] · [다시 실행] 단추를 걷으며 키로만 남겼다.
                     프로젝트는 폴더다 — 새로/열기는 폴더를 고른다. [다른 이름으로…]는 두지 않는다: 복제는 탐색기, 버전은 git.
                     manifest 이름은 사람이 짓지 않는다(ProjectFolder). -->
                <!-- File은 이웃 단추([📂 작업 폴더] · [⚙ 설정])와 같은 모양이다 — 테마의 맨 윗 메뉴 항목은 바탕이 투명해 글자만 보였다
                     (2026-11-18 소유자 · chrome-card-header U1). 단추의 바탕 · 모서리 · 여백을 그대로 빌린다 — 마우스를 올리면 테마의 메뉴
                     강조가 그 위에 선다. -->
                <Menu Grid.Column="0" x:Name="MainMenu" VerticalAlignment="Center">
                    <MenuItem x:Name="FileMenu"
                              Header="File"
                              Background="{DynamicResource ButtonBackground}"
                              Foreground="{DynamicResource ButtonForeground}"
                              CornerRadius="{DynamicResource ControlCornerRadius}"
                              Padding="{DynamicResource ButtonPadding}"
                              MinHeight="32">
                        <MenuItem x:Name="NewMenuItem" Header="새 프로젝트…"
                                  ToolTip.Tip="폴더를 고르면 그 안에 프로젝트를 깝니다(project.vnproject.json · story/)." />
                        <MenuItem x:Name="OpenMenuItem" Header="열기…"
                                  ToolTip.Tip="프로젝트 폴더를 고릅니다." />
                        <Separator />
                        <!-- 단축키 글(Ctrl+S · 맥은 ⌘S)은 코드가 단다 — OS마다 갈리는 것은 PlatformKeys 한 벌이다(MainWindow.axaml.cs). -->
                        <MenuItem x:Name="SaveMenuItem" Header="저장" />
                        <Separator />
                        <MenuItem x:Name="UndoMenuItem" Header="되돌리기"
                                  ToolTip.Tip="방금 한 편집 하나를 되돌립니다." />
                        <MenuItem x:Name="RedoMenuItem" Header="다시 실행"
                                  ToolTip.Tip="되돌린 편집을 다시 합니다." />
                    </MenuItem>
                </Menu>

                <!-- ⛔ [🎮 게임 폴더…]는 2026-11-17에 걷혔다 — 형식마다 보낼 곳은 [⚙ 설정]의 「내보내기」에서 정한다
                     (docs/work-orders/export-destinations-orders.md). -->

                <!--
                  진행 JSON · 대사 Yarn은 사람 손을 안 기다리고 저절로 나가므로, 사람이 할
                  일은 "가서 꺼내 오는 것"뿐이다. 그 자리를 모르면 꺼내 갈 수 없으니 폴더를 연다.
                  연출 든 게임용 Yarn은 ked-story-compositor가 낸다.
                -->
                <!-- ⛔ 2026-11-18까지 이름이 [📂 챕터진행]이었다(소유자 — 「작업 폴더로 바꿔주십시오」). -->
                <Button Grid.Column="2" x:Name="WorkFolderButton" Content="📂 작업 폴더"
                        ToolTip.Tip="작업 폴더(프로젝트 폴더의 exported/)를 엽니다 — 툴이 저절로 내는 챕터별 진행 JSON · 대사 Yarn(yarn/)이 여기 있습니다." />

                <!-- 설정은 이 창 하나에 모은다(2026-11-17 · docs/work-orders/settings-orders.md). -->
                <Button Grid.Column="3" x:Name="SettingsButton" Content="⚙ 설정" Margin="6,0,0,0"
                        ToolTip.Tip="설정 — [대본] 판 크기 · 복제할 폴더(게임 폴더 등) · 단축키 · 미니맵 · 설명 간소화" />

                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="8,0">
                    <TextBlock x:Name="ProjectNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ProjectPathText" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 주의: <b>맨 끝 열(마지막 Auto)이 이 표시의 자리다.</b> 앞에 단추를 하나
                     더하면 열이 늘고, 그때 <c>*</c>(프로젝트 이름)와 이 칸이 <b>함께</b>
                     밀려야 한다. 이름 칸만 옮기면 이 글이 <b>이름 위에 겹쳐</b> 선다.
                     열 번호는 둘이 한 쌍이다. -->
                <TextBlock Grid.Column="5"
                           x:Name="DirtyText"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- 상태줄은 <b>곁눈으로 읽는 줄</b>이다. 기본 글자크기(14)에 위아래 8씩
             주면 36px을 늘 차지하는데, 여기 뜨는 말은 대부분 "됐다"이고 그것은 크게
             볼 것이 아니다. 이 저장소가 곁정보에 쓰는 11로 맞춘다. -->
        <Border DockPanel.Dock="Bottom"
                Padding="12,4"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap" />
        </Border>

        <!-- 탭 둘 — [구성](챕터 그래프)과 [대본](연출 그래프). 틀은 같다: 왼쪽 하이어아키 · 가운데 판 · 오른쪽 탭 셋(인스펙터 · 화자 ·
             조건 및 스탯). 두 기둥은 접히고(ColumnDock) 두 탭이 함께 접힌다. 하이어아키의 접힘과 선택도 두 탭이 함께 쓴다.
             하는 일은 나뉜다: [대본]은 챕터 · 장면 · 에피소드를 더하고 지우고 이름을 고치며, 카드를 잇고(선택지 · 분기) 대사를 쓴다.
             [구성]은 ID · 조건 식 · 스탯 · 선택지의 표시/해금 조건과 스탯변화 · 캐릭터 키를 정한다(하이어아키는 읽기 전용).
             둘 다 세션의 편집기 한 벌로 고친다.
             창을 열면 [구성]이 서고, 새 프로젝트를 만들어도 [구성]으로 온다.
             무대 프리뷰는 연출 층과 함께 ked-story-compositor의 몫이다.
             주의: 둘의 순서는 건드리지 않는다 — `MainChromeTests`가 고정하고 있다. -->
        <TabControl x:Name="MainTabs" Padding="0">
            <!-- 탭 글은 18 · 높이 34 — 테마 기본(24 · 48)은 위 띠 · 툴바 사이를 넓게 벌렸다(2026-11-18 소유자 · chrome-card-header U1).
                 「>」 자식 고르기 — 판 안 오른쪽 기둥의 탭(제 크기가 따로 있다)에는 닿지 않는다. -->
            <TabControl.Styles>
                <Style Selector="TabControl#MainTabs > TabItem">
                    <Setter Property="FontSize" Value="18" />
                    <Setter Property="MinHeight" Value="34" />
                    <Setter Property="Padding" Value="12,0" />
                </Style>
            </TabControl.Styles>
            <TabItem x:Name="ChapterTabItem" Header="구성">
                <views:ChapterGraphView x:Name="ChapterGraph" />
            </TabItem>
            <TabItem x:Name="GraphTabItem" Header="대본">
                <views:GraphEditorView x:Name="Graph" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
