<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 파스텔 하늘 — 하늘색 바탕 · 흰 스티커 카드 · 분홍과 버터색 포인트. 기본 테마(Themes/Classic/Tokens.axaml) 위에 얹힌다 —
         여기 없는 이름은 기본 테마의 값이다. 단추 · 탭 같은 컨트롤의 모양은 Controls.axaml. -->

    <!-- 공통 -->
    <Color x:Key="OnAccent">#FFFFFF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="IconInk">#24415E</Color>
    <Color x:Key="Hairline">#6FA3C7</Color>
    <Color x:Key="Divider">#CFE6F5</Color>
    <Color x:Key="SwatchBorder">#24415E</Color>
    <Color x:Key="Neutral">#56708A</Color>
    <Color x:Key="NeutralLight">#8DA3B5</Color>
    <Color x:Key="NeutralDark">#3D5873</Color>

    <!-- 상태 -->
    <Color x:Key="Selection">#EE6B9E</Color>
    <Color x:Key="Join">#1F6FAE</Color>
    <Color x:Key="Accent">#2478B8</Color>
    <Color x:Key="Danger">#D4365A</Color>
    <Color x:Key="DangerDeep">#C2334F</Color>
    <Color x:Key="DangerText">#C2334F</Color>
    <Color x:Key="DangerButton">#C2334F</Color>
    <Color x:Key="Success">#1C8A5F</Color>
    <Color x:Key="Warning">#9A6700</Color>
    <Color x:Key="WarningText">#9A6700</Color>
    <Color x:Key="WarningMark">#F2A93B</Color>
    <Color x:Key="ProblemInk">#C2334F</Color>

    <!-- 틀 -->
    <Color x:Key="FloatingSurface">#F7FFFFFF</Color>
    <Color x:Key="FloatingBorder">#B5D9EF</Color>
    <Color x:Key="FloatingDivider">#CFE6F5</Color>
    <Color x:Key="FindBarSurface">#FAFFFFFF</Color>
    <Color x:Key="NoticeSurface">#FFF6D6</Color>
    <Color x:Key="NoticeBorder">#F2D675</Color>
    <Color x:Key="NoticeInk">#5A4300</Color>
    <Color x:Key="NoteBorder">#F2C94C</Color>

    <!-- [대본] 판 -->
    <Color x:Key="Scene">#18806A</Color>
    <Color x:Key="SceneProxySurface">#EFFAF6</Color>
    <Color x:Key="ProxySurface">#F3FAFE</Color>
    <Color x:Key="EpisodeAccent">#4AA3DB</Color>
    <Color x:Key="EpisodeSurface">#FFFFFF</Color>
    <Color x:Key="EpisodeBorder">#B5D9EF</Color>
    <Color x:Key="SceneRootAccent">#D99A0B</Color>
    <Color x:Key="SceneRootSurface">#FFFFFF</Color>
    <Color x:Key="SceneRootBorder">#B5D9EF</Color>
    <Color x:Key="BranchAccent">#7B62C9</Color>
    <Color x:Key="BranchSurface">#FFFFFF</Color>
    <Color x:Key="BranchBorder">#C9B8F0</Color>
    <Color x:Key="OtherCardAccent">#4AA3DB</Color>
    <Color x:Key="OtherCardSurface">#FFFFFF</Color>
    <Color x:Key="OtherCardBorder">#B5D9EF</Color>
    <Color x:Key="SlotLive">#E0526A</Color>
    <Color x:Key="SlotAsleep">#788DA3B5</Color>
    <Color x:Key="SlotPlaceholderBorder">#F2D675</Color>
    <Color x:Key="Rail">#F58FB0</Color>
    <Color x:Key="ChoiceInk">#A86B00</Color>
    <Color x:Key="Connection">#E05BB4E8</Color>
    <Color x:Key="BranchHub">#3D5873</Color>
    <Color x:Key="BranchHubOpen">#8DA3B5</Color>
    <Color x:Key="MinimapZoomHidden">#8DA3B5</Color>
    <Color x:Key="BranchLine1">#2478B8</Color>
    <Color x:Key="BranchLine2">#7B62C9</Color>
    <Color x:Key="BranchLine3">#18806A</Color>
    <Color x:Key="BranchLine4">#B87A00</Color>
    <Color x:Key="BranchLine5">#CF3F74</Color>
    <Color x:Key="BranchLine6">#1389A6</Color>

    <!-- [대본] 판 — 테두리 · 머리 띠 · 선택지 칸 -->
    <Color x:Key="ChapterFrameBorder">#FF8CCBF0</Color>
    <Color x:Key="ChapterFrameBorderIdle">#99B5D9EF</Color>
    <Color x:Key="ChapterFrameFill">#59FFFFFF</Color>
    <Color x:Key="ChapterFrameFillIdle">#33FFFFFF</Color>
    <Color x:Key="ChapterLabel">#FF8CCBF0</Color>
    <Color x:Key="ChapterLabelIdle">#FFCFE6F5</Color>
    <Color x:Key="ChapterLabelInk">#24415E</Color>
    <Color x:Key="SceneFrameBorder">#FFFFFFFF</Color>
    <Color x:Key="SceneFrameFill">#8CFFFFFF</Color>
    <Color x:Key="SceneLabel">#FFFFFFFF</Color>
    <Color x:Key="SceneLabelInk">#24415E</Color>
    <Color x:Key="EpisodeBand">#CDE9F9</Color>
    <Color x:Key="SceneRootBand">#CDE9F9</Color>
    <Color x:Key="BranchBand">#E3DAF9</Color>
    <Color x:Key="OtherCardBand">#CDE9F9</Color>
    <Color x:Key="SelectedBand">#FFD9E5</Color>
    <Color x:Key="SlotSurface">#FFF6D6</Color>
    <Color x:Key="SlotInk">#24415E</Color>
    <Color x:Key="RowSelected">#FFE3EC</Color>

    <!-- [구성] 판 -->
    <Color x:Key="StructureDesk">#DCEFFA</Color>
    <Color x:Key="StructureCardSurface">#FFFFFFFF</Color>
    <Color x:Key="StructureSlot">#7FA6C2</Color>
    <Color x:Key="StructureEdge">#7FB5DA</Color>
    <Color x:Key="StructureEdgeConditioned">#D9A441</Color>
    <Color x:Key="StructureEdgeInk">#3D5873</Color>
    <Color x:Key="StructureLabelSurface">#F0FFFFFF</Color>
    <Color x:Key="StructureBranchChipSurface">#F7F3FF</Color>
    <Color x:Key="StructureInk">#24415E</Color>
    <Color x:Key="StructureInkSoft">#56708A</Color>
    <Color x:Key="ConditionVisible">#7B62C9</Color>
    <Color x:Key="ConditionUnlock">#9A6700</Color>
    <Color x:Key="CardName">#24415E</Color>
    <Color x:Key="StatKey">#2478B8</Color>
    <Color x:Key="StatValue">#24415E</Color>
    <Color x:Key="SceneChip">#6B52B8</Color>

    <!-- 모양 -->
    <x:Double x:Key="CardRadius">14</x:Double>
    <x:Double x:Key="OtherCardRadius">14</x:Double>
    <x:Double x:Key="ChapterFrameRadius">24</x:Double>
    <x:Double x:Key="SceneFrameRadius">20</x:Double>
    <x:Double x:Key="LabelRadius">11</x:Double>
    <x:Double x:Key="ChipRadius">9</x:Double>
    <x:Double x:Key="CardSpineOpacity">0</x:Double>
    <x:Double x:Key="LineWeight">1.7</x:Double>
    <x:Double x:Key="SlotRadius">10</x:Double>
    <x:Double x:Key="SlotPill">1</x:Double>
    <x:String x:Key="CardSelectedShadow">0 0 0 2 #EE6B9E, 0 5 0 0 #F7B6CB</x:String>
    <x:String x:Key="CardShadow">0 4 0 0 #B5D9EF</x:String>

    <!-- ─────────────────────────────────────────────────────────────────────────
         틀 — XAML만 쓰는 이름. 기본 테마에는 없어서 거기서는 비어 있다(바탕 없음 · 높이 0).
         ───────────────────────────────────────────────────────────────────────── -->
    <!-- 위 띠의 바탕 -->
    <SolidColorBrush x:Key="TopBarBackground" Color="#8CCBF0" />
    <!-- 위 띠 아래의 구름 물결 — 하늘색 띠 위로 흰 반원이 솟는다(24 × 10 조각을 가로로 깐다) -->
    <x:Double x:Key="TopBarEdgeHeight">10</x:Double>
    <DrawingBrush x:Key="TopBarEdgeBrush" TileMode="Tile" SourceRect="0,0,24,10" DestinationRect="0,0,24,10">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#8CCBF0" Geometry="M0,0 H24 V10 H0 Z" />
                <GeometryDrawing Brush="#FFFFFF">
                    <GeometryDrawing.Geometry>
                        <EllipseGeometry Center="12,11" RadiusX="11" RadiusY="10" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <!-- 판 아래 안내 줄의 바탕 -->
    <SolidColorBrush x:Key="HintSurface" Color="#FFF6D6" />
    <!-- [대본] 판의 바탕 -->
    <SolidColorBrush x:Key="BoardBackground" Color="#DCEFFA" />

    <!-- 글꼴 — 테마 폴더의 Fonts/에 실은 것(SIL OFL 1.1). 본문은 Gowun Dodum(한글 11,172자 모두), 제목은 Jua(없는 글자는 본문 글꼴로 그려진다) -->
    <FontFamily x:Key="UiFont">avares://StoryDirector/Themes/PastelSky/Fonts#Gowun Dodum</FontFamily>
    <FontFamily x:Key="DisplayFont">avares://StoryDirector/Themes/PastelSky/Fonts#Jua, avares://StoryDirector/Themes/PastelSky/Fonts#Gowun Dodum</FontFamily>

    <!-- ─────────────────────────────────────────────────────────────────────────
         컨트롤의 색 · 모서리 — Fluent 테마가 쓰는 이름을 덮는다(단추 · 글 칸 · 고르기 칸 · 탭 · 풍선 · 메뉴).
         ───────────────────────────────────────────────────────────────────────── -->
    <!-- 강조색(고른 글 · 초점 테두리 · 체크) — 벚꽃 -->
    <Color x:Key="SystemAccentColor">#E8588F</Color>
    <Color x:Key="SystemAccentColorDark1">#D6457A</Color>
    <Color x:Key="SystemAccentColorDark2">#C23A6B</Color>
    <Color x:Key="SystemAccentColorDark3">#A82E5A</Color>
    <Color x:Key="SystemAccentColorLight1">#F58FB0</Color>
    <Color x:Key="SystemAccentColorLight2">#F9B4CB</Color>
    <Color x:Key="SystemAccentColorLight3">#FFD9E5</Color>

    <!-- 글 -->
    <SolidColorBrush x:Key="SystemControlForegroundBaseHighBrush" Color="#24415E" />

    <!-- 모서리 -->
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

    <!-- 단추 -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#EAF5FC" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D6ECFA" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#BFDDF0" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#8CCBF0" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#8CCBF0" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#24415E" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#24415E" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#24415E" />
    <Thickness x:Key="ButtonBorderThemeThickness">1.5</Thickness>
    <Thickness x:Key="TextControlBorderThemeThickness">2</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">2</Thickness>
    <Thickness x:Key="ComboBoxBorderThemeThickness">2</Thickness>

    <!-- 글 칸 -->
    <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#BFDDF0" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#8CCBF0" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#24415E" />
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#24415E" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#24415E" />

    <!-- 고르기 칸 -->
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#EAF5FC" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#D6ECFA" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#BFDDF0" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#8CCBF0" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#8CCBF0" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="#24415E" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#BFDDF0" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EAF5FC" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#FFD9E5" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#FFD9E5" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="#24415E" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="#24415E" />

    <!-- 탭 -->
    <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="#F58FB0" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelected" Color="#24415E" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPointerOver" Color="#24415E" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundSelectedPressed" Color="#24415E" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselected" Color="#56708A" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPointerOver" Color="#24415E" />
    <SolidColorBrush x:Key="TabItemHeaderForegroundUnselectedPressed" Color="#24415E" />

    <!-- 접는 묶음(설정 창) -->
    <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="#EAF5FC" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="#CFE6F5" />
    <SolidColorBrush x:Key="ExpanderContentBackground" Color="#F7FBFE" />
    <SolidColorBrush x:Key="ExpanderContentBorderBrush" Color="#CFE6F5" />

    <!-- 풍선 · 메뉴 -->
    <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFDF5" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#F2D675" />
    <SolidColorBrush x:Key="ToolTipForeground" Color="#24415E" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#BFDDF0" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EAF5FC" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#D6ECFA" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#24415E" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#24415E" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#24415E" />
</ResourceDictionary>
