<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 파스텔 하늘 — 컨트롤의 모양 · 글꼴 · 눌림. 색은 모두 Tokens.axaml에 이름으로 있다(여기에 색을 숫자로 적지 않는다 — 이름의 목록 Theming/ThemeKeys.cs 하나로 모든 색을 고칠 수 있게 · ThemeTests가 지킨다).
         화면이 붙여 둔 클래스로 고른다 — 「chunky」(틀의 큰 단추 · 「primary」 만들기 · 「danger」 지우기), 「card-title」(카드 제목), 「frame-title」(챕터 · 장면 이름표),
         「card-writing」(카드 글 칸). 클래스는 기본 테마에서는 아무 일도 하지 않는다. -->

    <!-- 글꼴 — 창마다(주 창 · 설정 창). 창 안의 글은 이것을 물려받는다. -->
    <!-- 창의 바탕은 새하얀색이 아니라 따뜻한 종이빛이다 — 넓은 흰 면의 눈부심을 줄인다(위 띠 아래 구름 물결의 색과 같다 · Tokens.axaml). -->
    <Style Selector=":is(Window)">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <!-- 단추의 모양은 하나다 — 1px 테두리 · 모서리 6 · 평평한 면(2026-11-26 — 디자인 점검 3번 「단추 언어를 하나로」). 틀의 큰 일(.chunky)은 같은 모양에
         굵은 글 · 조금 큰 여백이다. 켜고 끄는 단추(서식 도구)는 켜지면 옅은 파랑 면이다(색은 Tokens.axaml).
         ⛔ 그 전에는 작은 단추(모서리 10)와 두툼한 「스티커」 단추(2px 테두리에 아래만 5px · 모서리 14 · 누르면 내려앉음)의 두 말이 섞였다. -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- 체크 상자는 네모다(2026-11-26 — 윈도우의 문법: 동그라미는 「하나만 고르기」(라디오 단추)다). Fluent는 체크 상자의 모서리를 컨트롤 공통
         모서리(ControlCornerRadius 12)로 그려 20px 칸이 동그라미가 됐다. 라디오 단추는 그대로 동그라미다. -->
    <Style Selector="CheckBox">
        <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- 올림 · 눌림의 반응은 어디서나 같다 — 올리면 옅은 하늘색 면, 누르면 한 단계 짙은 면(색은 Tokens.axaml)으로 짧게 바뀐다. -->
    <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleButton">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- 틀의 큰 단추(.chunky — 작업 폴더 · 설정 · + 에피소드 · 삭제 · 자동 정렬 …) — 여느 단추와 같은 1px 테두리 · 모서리 6에 굵은 글(SemiBold)이다.
         높이 28 안팎, 글은 위 · 아래 여백이 같아 한가운데에 선다(제목 글꼴 Pretendard의 한글은 글줄의 한가운데에 앉는다). 누르면 면만 한 단계 짙어지고
         자리는 그대로다. ⛔ 2026-11-26(디자인 점검 3번)까지는 2px 테두리에 아래만 5px인 「스티커」였다 — 누르면 내려앉았고, 아래 두께 몫만큼 여백을
         비틀어야 글이 가운데에 섰다(6 · 3). 그 전에는 두께를 아래 그림자로 냈다가 단추 밖에서 잘렸다. -->
    <Style Selector="Button.chunky">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.chunky /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyBorder}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.chunky:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyBorderHover}" />
    </Style>
    <Style Selector="Button.chunky:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>

    <!-- 만들기 — 강조색(하늘) 면에 흰 글 -->
    <Style Selector="Button.chunky.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChunkyPrimaryBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyPrimaryBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ChunkyPrimaryForeground}" />
    </Style>
    <Style Selector="Button.chunky.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChunkyPrimaryBackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyPrimaryBorder}" />
    </Style>
    <!-- 누르면 한 단계 짙은 파랑(테두리의 색) — 자리는 그대로다 -->
    <Style Selector="Button.chunky.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChunkyPrimaryBorder}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyPrimaryBorder}" />
    </Style>

    <!-- 지우기 — 모양은 여느 두툼한 단추(종이빛 면 · 회청색 테두리)와 같고 글만 주홍이다. 마우스를 올리면 테두리도 주홍이 된다.
         면이나 테두리를 늘 색으로 칠하지 않는다 — 고른 것 · 만들기의 파랑과 무게가 달라야 하고, 늘 서 있는 단추라 조용해야 한다. -->
    <Style Selector="Button.chunky.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChunkyDangerBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyDangerBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ChunkyDangerForeground}" />
    </Style>
    <Style Selector="Button.chunky.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyDangerBorderHover}" />
    </Style>
    <Style Selector="Button.chunky.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ChunkyDisabledBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ChunkyDisabledBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource ChunkyDisabledForeground}" />
    </Style>

    <!-- 위 띠(회하늘색 바탕) 위의 두툼한 단추 — 테두리가 바탕에 묻히지 않게 한 단계 짙다. File 메뉴도 같은 모양이다. -->
    <Style Selector="Grid#TopBar Button.chunky /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource TopBarButtonBorder}" />
    </Style>
    <Style Selector="Menu#MainMenu > MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- File도 이웃 단추와 같은 1px 테두리 · 모서리 6이다 — 글은 옮기지 않아도 한가운데에 선다(⛔ 아래 5px 두께가 있을 때는 글만 1.5 · Jua일 때는 3 내렸다). -->
    <Style Selector="Menu#MainMenu > MenuItem:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource TopBarButtonBorder}" />
    </Style>

    <!-- 탭 — 밑줄 대신 면(먹색)으로 고른 것을 말한다. 기둥의 탭(인스펙터 · 화자 · 조건 및 스탯)은 작은 알약, 주 탭([대본] · [구성])은 두툼한 스티커 탭이다. -->
    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,2" />   <!-- 위 · 아래 같다(⛔ Jua일 때는 높이 앉는 만큼 1 내려 10,3,10,1이었다) -->
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>
    <!-- 고른 탭은 옅은 파랑 면이다(윈도우의 고름 · 강조색). 글자색은 면과 한 쌍이라 여기서 함께 정한다. 기둥의 탭은 아래에 강조색 막대가 선다(PART_SelectedPipe). -->
    <Style Selector="TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabSelectedBackground}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundSelected}" />
    </Style>
    <!-- 주 탭([대본] · [구성]) — 위 띠의 File 옆에 선 한 덩어리의 전환 단추다(2026-11-26 — 디자인 점검 3번): 옅은 회색 바닥(MainTabTrack · 모서리 8 ·
         안쪽 2) 위에 두 칸이 붙어 서고, 고른 칸만 흰 면 + 옅은 테두리로 떠오른다. 안 고른 칸은 테두리 · 면이 없다.
         ⛔ 그 전에는 위 띠 아래 따로 선 줄에 두툼한 스티커 탭 둘(2px 테두리에 아래만 5px · 고르면 파란 테두리)이 떨어져 섰다. -->
    <Style Selector="TabControl#MainTabs">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="{DynamicResource MainTabTrack}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem">
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="30" />
    </Style>
    <!-- ⚠ 템플릿이 묶어 둔 값(TemplateBinding)은 보통 스타일보다 세다 — 조건이 붙은 스타일(:not(:disabled) · :selected)이어야 그 위에 선다. -->
    <Style Selector="TabControl#MainTabs > TabItem:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="Padding" Value="16,2" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource TabHoverBackground}" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource MainTabBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MainTabBorder}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TabItemHeaderForegroundSelected}" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- [대본] 툴바의 서식 도구 단추 — 평소에는 테두리 · 면 없이 글자만, 마우스를 올리거나 켜진 것만 면이 선다(2026-11-26 — 디자인 점검 3번 · ⛔ 그 전에는
         크기가 제각각인 동그라미가 줄지어 섰다). -->
    <Style Selector="StackPanel#WriterToolbar Button:not(:pointerover):not(:pressed) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel#WriterToolbar ToggleButton:not(:checked):not(:pointerover):not(:pressed) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 위 띠의 프로젝트 경로 — 이 테마에서는 이름만 보이고 경로는 이름에 마우스를 올리면 풍선으로 보인다(2026-11-26 — 디자인 점검 3번). -->
    <Style Selector="TextBlock#ProjectPathText">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- 챕터 · 장면 이름표 — 이름표 글꼴(Jua · 말랑한 인상은 여기 두 곳에서만 낸다) -->
    <Style Selector="TextBlock.frame-title">
        <Setter Property="FontFamily" Value="{DynamicResource FrameFont}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- 인스펙터의 대사 목록 — 줄마다 화자 칸 · 대사 칸의 테두리를 걷는다. 쓰지 않는 동안에는 글만 줄지어 서고(읽는 목록), 마우스를 올리거나 쓰는 칸에만
         테두리가 선다. 줄 사이는 구분선 하나다(LineRowBoxed 0). 모서리도 작게 — 둥근 알약 상자가 줄마다 둘씩 쌓이면 글보다 상자가 먼저 보인다. -->
    <Style Selector="StackPanel#LineHost TextBox">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="StackPanel#LineHost TextBox:not(:focus):not(:pointerover) /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="StackPanel#LineHost AutoCompleteBox /template/ TextBox#PART_TextBox">
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="StackPanel#LineHost AutoCompleteBox /template/ TextBox#PART_TextBox:not(:focus):not(:pointerover) /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- 카드 제목 -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- 카드 글 칸 — 카드의 흰 면이 곧 글 칸이다. 테두리 자리는 그대로 두고(치수가 같다) 색만 걷는다. 쓰는 동안에는 강조색 테두리가 선다. -->
    <Style Selector="TextBox.card-writing /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.card-writing:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardWritingHoverBorder}" />
    </Style>
    <Style Selector="TextBox.card-writing:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource CardWritingFocusBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardWritingFocusBorder}" />
    </Style>
</Styles>
