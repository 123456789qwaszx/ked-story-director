<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 파스텔 하늘 — 컨트롤의 모양 · 글꼴 · 눌림. 색은 Tokens.axaml(Fluent 테마의 이름을 덮는다)에 있고, 여기는 색 이름만으로 못 바꾸는 것을 적는다.
         화면이 붙여 둔 클래스로 고른다 — 「chunky」(틀의 큰 단추 · 「primary」 만들기 · 「danger」 지우기), 「card-title」(카드 제목),
         「card-writing」(카드 글 칸). 클래스는 기본 테마에서는 아무 일도 하지 않는다. -->

    <!-- 글꼴 — 창마다(주 창 · 설정 창). 창 안의 글은 이것을 물려받는다. -->
    <Style Selector=":is(Window)">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    </Style>

    <!-- 단추 — 둥근 알약 -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- 두툼한 단추(스티커) — 2px 테두리 + 번지지 않는 아래 그림자. 누르면 그림자만큼 내려앉는다. -->
    <Style Selector="Button.chunky">
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="Button.chunky /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 3 0 0 #BFDDF0" />
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.chunky:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 3 0 0 #8CCBF0" />
    </Style>
    <Style Selector="Button.chunky:pressed">
        <Setter Property="RenderTransform" Value="translateY(3px)" />
    </Style>
    <Style Selector="Button.chunky:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 0 #8CCBF0" />
    </Style>

    <!-- 만들기(버터) -->
    <Style Selector="Button.chunky.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFE9A8" />
        <Setter Property="BorderBrush" Value="#F2C94C" />
        <Setter Property="BoxShadow" Value="0 3 0 0 #F2C94C" />
    </Style>
    <Style Selector="Button.chunky.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFE08A" />
    </Style>
    <Style Selector="Button.chunky.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 0 #F2C94C" />
    </Style>

    <!-- 지우기(산호) -->
    <Style Selector="Button.chunky.danger /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#FFE7E7" />
        <Setter Property="BorderBrush" Value="#F3B4B4" />
        <Setter Property="BoxShadow" Value="0 3 0 0 #F3B4B4" />
        <Setter Property="Foreground" Value="#A8323E" />
    </Style>
    <Style Selector="Button.chunky.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BoxShadow" Value="0 0 0 0 #F3B4B4" />
    </Style>
    <Style Selector="Button.chunky.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F3F7FA" />
        <Setter Property="BorderBrush" Value="#D9E6EF" />
        <Setter Property="BoxShadow" Value="0 3 0 0 #D9E6EF" />
        <Setter Property="Foreground" Value="#8DA3B5" />
    </Style>

    <!-- 주 탭([대본] · [구성]) — 두툼한 스티커 탭. 밑줄 대신 면으로 고른 것을 말한다. -->
    <Style Selector="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    </Style>
    <Style Selector="TabControl#MainTabs">
        <Setter Property="Margin" Value="10,4,0,2" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem">
        <Setter Property="Margin" Value="0,0,8,2" />
        <Setter Property="MinHeight" Value="38" />
    </Style>
    <!-- ⚠ 템플릿이 묶어 둔 값(TemplateBinding)은 보통 스타일보다 세다 — 조건이 붙은 스타일(:not(:disabled) · :selected)이어야 그 위에 선다.
         그림자는 탭 줄이 잘라 내므로, 두께는 아래쪽이 굵은 테두리로 낸다. -->
    <Style Selector="TabControl#MainTabs > TabItem:not(:disabled) /template/ Border#PART_LayoutRoot">
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="2,2,2,5" />
        <Setter Property="BorderBrush" Value="#BFDDF0" />
        <Setter Property="Background" Value="#FFFFFF" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#EAF5FC" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="#FFD9E5" />
        <Setter Property="BorderBrush" Value="#F58FB0" />
    </Style>
    <Style Selector="TabControl#MainTabs > TabItem:selected /template/ Border#PART_SelectedPipe">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- 카드 제목 -->
    <Style Selector="TextBlock.card-title">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- 카드 글 칸 — 카드의 흰 면이 곧 글 칸이다. 테두리 자리는 그대로 두고(치수가 같다) 색만 걷는다. 쓰는 동안에는 강조색 테두리가 선다. -->
    <Style Selector="TextBox.card-writing /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="TextBox.card-writing:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="#CDE9F9" />
    </Style>
    <Style Selector="TextBox.card-writing:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#F58FB0" />
    </Style>
</Styles>
