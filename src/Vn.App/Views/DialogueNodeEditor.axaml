<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />

                <!-- 대본은 노드와 함께 태어난다 (X4) — 선택·가져오기 진입점 없음.
                     줄 수·로케일은 2026-08-22에 <b>이름 오른쪽</b>으로 올라왔다 (소유자) —
                     제 줄을 차지할 만큼의 정보가 아니고, 머리글과 떨어져 있으면 무엇에 대한
                     숫자인지 한 박자 늦게 읽힌다. -->
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Grid.Column="0"
                               x:Name="ScriptSummaryTitleText"
                               Text="대본"
                               FontSize="11"
                               Opacity="0.7"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="ScriptSummaryText"
                               Margin="8,0,6,0"
                               FontSize="11"
                               Opacity="0.65"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <!-- ⛔ 대사 잠금 토글([🔒 대사 잠김])은 2026-09-16에 사라졌다 (R-E ·
                         지시서 §6.4). 그것이 지키던 것은 "여기서 고쳐도 다음 동기화가
                         되돌린다"였는데, 그 동기화가 R-D에서 철거됐다 — 이제 <b>모든 노드의
                         대본은 툴 소유</b>이고 잠글 원본이 없다. 열의 자리는 남는다
                         (Grid.Column 3 = [줄 추가]). -->
                    <Button Grid.Column="3"
                            x:Name="AddLineButton"
                            Content="줄 추가"
                            FontSize="11" />
                </Grid>

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- ⚠ [기본 출구] 편집 구역은 2026-08-22에 사라졌다 (소유자: "연출그래프에서
             만질 일이 없을 테니 그냥 없애도 될 것 같아") — 같은 값을 판의 레일
             칩(`○ 진행`)이 이미 편집한다. 한 값에 편집 창구가 둘이면 어느 쪽이
             최신인지 화면이 대답하지 못한다. 데이터·포트·출력은 그대로다.
             ⛔ 탭은 2026-10-29에 걷혔다 — [발행] 탭(2026-09-15)에 이어 [Script Preview] 탭도 걷혀(소유자:
             "더 이상 필요없으니 완전히 제거") 남는 것이 대사 편집 하나다. 긴 대본은 카드 안 글 칸(D4)에 붙여 넣는다. -->
        <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다 (W49). -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LineScroll"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
        </ScrollViewer>
    </Grid>
</UserControl>
