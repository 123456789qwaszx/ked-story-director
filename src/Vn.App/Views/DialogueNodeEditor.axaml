<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />
                </Grid>

                <Button x:Name="AddLineButton"
                        HorizontalAlignment="Right"
                        Content="줄 추가"
                        FontSize="11" />

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- 주의: [기본 출구]는 여기서 편집하지 않는다 — 같은 값을 판의 레일
             칩(`○ 진행`)이 편집한다. 한 값에 편집 창구가 둘이면 어느 쪽이
             최신인지 화면이 대답하지 못한다.
             이 편집기는 대사 편집 하나다. 긴 대본은 카드 안 글 칸에 붙여 넣는다. -->
        <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다. -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LineScroll"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
        </ScrollViewer>
    </Grid>
</UserControl>
