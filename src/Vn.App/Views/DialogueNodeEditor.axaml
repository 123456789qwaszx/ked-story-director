<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vn.App.Views.DialogueNodeEditor">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Padding="12,10"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox x:Name="NameBox" FontWeight="SemiBold" PlaceholderText="장면 이름" />
                    <!-- 빈 선택지 숨기기 — 에피소드 카드만. 다 이은 카드는 안 이은 칸이 판만 어지럽힌다. -->
                    <CheckBox Grid.Column="1"
                              x:Name="HideEmptyChoicesBox"
                              Content="빈 선택지 숨기기"
                              FontSize="11"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center"
                              IsVisible="False"
                              ToolTip.Tip="켜면 [대본] 탭에서 이 카드 아래에 이어진 선택지만 보입니다 — 안 이은 칸은 자동 칸까지 감춥니다. 새로 잇거나 문구를 적으려면 끄세요." />
                </Grid>

                <Button x:Name="AddLineButton"
                        HorizontalAlignment="Right"
                        Content="줄 추가"
                        FontSize="11" />

                <TextBlock x:Name="ProblemText"
                           FontSize="11"
                           Foreground="#C2410C"
                           TextWrapping="Wrap"
                           IsVisible="False" />
            </StackPanel>
        </Border>

        <!-- 주의: [기본 출구]는 여기서 편집하지 않는다 — 같은 값을 판의 레일
             칩(`○ 진행`)이 편집한다. 한 값에 편집 창구가 둘이면 어느 쪽이
             최신인지 화면이 대답하지 못한다.
             이 편집기는 대사 편집 하나다. 긴 대본은 카드 안 글 칸에 붙여 넣는다. -->
        <!-- Background이 있어야 카드 아래 빈 공간이 우클릭을 받는다. -->
        <ScrollViewer Grid.Row="1"
                      x:Name="LineScroll"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="LineHost" Margin="12" Spacing="3" />
        </ScrollViewer>
    </Grid>
</UserControl>
