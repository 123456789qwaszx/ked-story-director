<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.ChapterGraphView">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Padding="10,8"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <!-- [다시 읽기] 단추는 두지 않는다 — **화면이 저절로 따라오기 때문이다.** 챕터 폴더와
                 대본 폴더에 감시자가 붙어 있고, 저장이 내려앉으면 화면이 스스로 다시 읽는다. -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- 주의: 왼쪽 무리는 <b>연출 그래프 툴바와 한 쌍</b>이다.
                     같은 StackPanel(Spacing=6) · 같은 라벨 여백 · 콤보 뒤 같은 구분선.
                     짝: `GraphEditorView.axaml`의 툴바 — 한쪽을 고치면 둘 다 고친다.
                     (콤보 치수가 한 쌍인 것도 같은 이유다.) -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="챕터"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <ComboBox x:Name="ChapterCombo" MinWidth="180" FontSize="11" />
                    <!-- [내보내기] 단추는 두지 않는다.
                         챕터 진행 JSON이 사람 손을 기다리면 누른 순간의 낡은 파일이 디스크에
                         남는다. 다시 읽을 때마다 저절로 나간다 — 내보내기의 거부 규칙은 그대로 적용된다. -->
                    <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                    <Button x:Name="AddEpisodeButton"
                            Content="＋ 에피소드"
                            ToolTip.Tip="선택된 에피소드의 다음으로 새 에피소드를 만들어 잇습니다. 선택이 없으면 홀로 섭니다. 이름은 우측 [이름] 칸에서 고치고 Enter." />

                    <!-- 자동 정렬 — 자리의 주인이 사람이라서
                         필요한 짝이다. 손으로 옮기다 판이 엉키면 되돌릴 길이 있어야 한다.
                         연출 그래프의 카드 자리를 본뜬다(`ChapterBranchPlanner.LayoutLikeBoard`).
                         주의: 한 번의 변경이라 Ctrl+Z 한 번이면 옮기기 전으로 돌아온다. -->
                    <Button x:Name="AutoArrangeButton"
                            Content="자동 정렬"
                            ToolTip.Tip="모든 카드를 [대본] 탭에 놓인 모양대로 다시 세웁니다. 손으로 옮긴 자리는 사라집니다 — 되돌리기(Ctrl+Z) 한 번으로 돌아옵니다." />
                </StackPanel>

                <!-- 픽스처(재생루트 하이라이트)는 화면에 세우지 않는다.
                     주의: 챕터의 픽스처와 `ChapterFixtureWalker`는 남아 있다 — 화면만 없으므로
                     다시 보이려면 콤보와 걷기 호출을 세우면 된다. -->

                <!-- 편집은 언제나 열려 있다. 오른쪽 끝이 파괴적 동작의 자리다 — 빨갛게. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <!-- 삭제는 늘 같은 자리에 있다 — 자리가 움직이면 그 자리를
                         누르던 손이 삭제를 누른다. 빨간 것은 지우는 단추라서다. -->
                    <Button x:Name="DeleteEpisodeButton"
                            Content="에피소드 삭제"
                            FontSize="11"
                            VerticalAlignment="Center"
                            Background="#C0392B"
                            Foreground="White"
                            ToolTip.Tip="선택한 에피소드와 그 에피소드를 오가는 간선, [대본] 탭의 카드를 함께 지웁니다. 챕터의 선택지 문구는 그대로 둡니다. 되돌리기(Ctrl+Z)로 돌아옵니다." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 인스펙터 폭 340 — 조건 식·대사 미리보기가 300에서는 줄바꿈으로 부서진다. -->
        <Grid Grid.Row="1" x:Name="BoardColumns">
            <!-- 하이어아키 · 판 · 인스펙터 — 유니티와 같은 차례. 하이어아키 폭은 사람이 끈다(최소 140 —
                 0까지 끌어 사라지면 다시 잡을 손잡이가 없다). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 하이어아키: 프로젝트 → 챕터 → 장면 → 에피소드를
                 유니티 하이어아키처럼 접었다 편다. 챕터 고르기 · 우클릭(이름 바꾸기 · 제거)은 챕터 줄이 맡는다.
                 판 <b>왼쪽 기둥</b>이다 — 유니티처럼
                 하이어아키 · 판 · 인스펙터가 왼쪽에서 오른쪽으로 선다. 폭은 오른쪽 스플리터로 사람이 정한다.
                 주의: 줄을 고른 뒤의 일(챕터 · 에피소드 고르기, 아래 칸 바꾸기)은 이 뷰가, 내용(프로젝트 · 챕터 목록)과
                 챕터 줄 우클릭은 셸(MainWindow)이 짓는다 — 세션 전환 · 개명 규칙이 셸에 한 벌이다. -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,1,0">
                <Panel>
                <Grid x:Name="HierarchyOpen" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="하이어아키" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChapterSummary"
                                           FontSize="11"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="AddChapterButton"
                                    Content="＋"
                                    FontSize="12"
                                    Padding="7,2"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="새 챕터 — 프로젝트에 챕터를 만들고 판을 엽니다." />
                            <Button Grid.Column="2"
                                    x:Name="FoldHierarchyButton"
                                    Content="‹"
                                    FontSize="12"
                                    Padding="7,0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    ToolTip.Tip="하이어아키를 접습니다 — 판이 넓어집니다. 접힌 띠를 누르면 다시 폅니다." />
                        </Grid>
                    </Border>

                    <views:StoryHierarchy Grid.Row="1" x:Name="Hierarchy" />
                </Grid>

                    <!-- 접힌 하이어아키 — 세로 띠 하나. 누르면 편다(HierarchyDock). -->
                    <Button x:Name="HierarchyStrip"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Top"
                            Padding="0,6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="하이어아키를 펼칩니다">
                        <StackPanel Spacing="8">
                            <TextBlock Text="›" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <LayoutTransformControl>
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock Text="하이어아키" FontSize="11" Opacity="0.7" />
                            </LayoutTransformControl>
                        </StackPanel>
                    </Button>
                </Panel>
            </Border>

            <GridSplitter Grid.Column="1"
                          x:Name="HierarchySplitter"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <Grid Grid.Column="2">
                <!-- 휠 확대·축소(Ctrl 없이) / 가운데 단추 끌어 이동.
                     연출 그래프와 같은 손놀림이다 — 판이 둘인데 다루는 법이 다르면
                     손이 매번 헷갈린다. 배율은 ZoomHost의 LayoutTransform이 진다:
                     캔버스 좌표(배치·간선 산식)는 배율을 몰라도 된다. -->
                <ScrollViewer x:Name="GraphScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <LayoutTransformControl x:Name="ZoomHost">
                        <Canvas x:Name="GraphCanvas" Background="Transparent" />
                    </LayoutTransformControl>
                </ScrollViewer>

                <!-- 배율 표시 — 100%가 아닐 때만. 누르면 100%로 돌아온다. -->
                <Button x:Name="ZoomResetButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,18"
                        Padding="8,3"
                        FontSize="11"
                        IsVisible="False"
                        ToolTip.Tip="배율을 100%로 되돌립니다. 휠로 확대·축소, 가운데 단추를 끌어 이동합니다.">
                    <TextBlock x:Name="ZoomText" />
                </Button>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.55"
                               TextWrapping="Wrap"
                               MaxWidth="420" />
                    <!-- 빈 판의 첫걸음은 <b>둘 중 하나만</b> 선다. 프로젝트가 아직 없으면 [새 프로젝트]가, 프로젝트는
                         있는데 챕터가 하나도 없으면 [＋ 챕터]가 선다 — 안내문만 있으면
                         다음 할 일이 글로만 서 있으니, 누를 자리가 판 한가운데 함께 선다.
                         배선은 셸: 각각 툴바의 [새로 만들기]·우측 기둥의 [＋]와 같은 길이다. -->
                    <Button x:Name="EmptyNewProjectButton"
                            Content="새 프로젝트"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            IsVisible="False"
                            ToolTip.Tip="새 프로젝트를 만들고 저장합니다 — 저장돼야 챕터가 살 폴더가 정해집니다." />
                    <Button x:Name="EmptyAddChapterButton"
                            Content="＋ 챕터"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            IsVisible="False"
                            ToolTip.Tip="새 챕터 — 프로젝트에 챕터를 만들고 판을 엽니다." />
                    <!-- 셋째 걸음 — 챕터는 열렸는데 에피소드가 하나도 없을 때. 앞의 둘과
                         달리 배선까지 이 뷰의 것이다: 툴바의 [＋ 에피소드]와 같은 길을 탄다
                         (선택이 없으니 홀로 선다). -->
                    <Button x:Name="EmptyAddEpisodeButton"
                            Content="＋ 에피소드"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            IsVisible="False"
                            ToolTip.Tip="첫 에피소드를 만듭니다 — 이름은 우측 [이름] 칸에서 고치고 Enter." />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 오른쪽 기둥은 인스펙터 하나다 — 챕터 구조의 편집은 여기서, 대사는 연출 그래프의 카드에서.
                 모든 편집은 프로젝트를 고치고, 변경 알림이 그래프를 다시 그린다. -->
            <Grid Grid.Column="4" x:Name="ChapterRightRows">

                <!-- 인스펙터: 하이어아키나 판에서 고른 것을 보인다. 프로젝트 →
                     화자, 챕터 → 조건 · 스탯, 장면 → 장면 이름, 에피소드 · 선택지(길) · 분기 → 그 편집. 머리글이 무엇을
                     보는지 말한다.
                     탭으로 나누지 않는다 — 고르는 것이 내용을 정한다.
                     -->
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="1">
                            <TextBlock x:Name="InspectorTitle" Text="인스펙터" FontWeight="SemiBold" />
                            <TextBlock x:Name="InspectorSubtitle"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Panel Grid.Row="1">
                    <!-- 고른 하나 — 에피소드 · 선택지(길) · 분기, 그리고 장면. -->
                    <ScrollViewer x:Name="SelectionSection"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="6">
                    <TextBlock x:Name="NoSelectionText"
                               Text="노드 클릭 = 선택&#x0A;선택한 뒤 [＋ 에피소드] = 다음 에피소드로 잇기&#x0A;선(길) 클릭 = 표시·해금조건과 스탯변화 편집"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />

                    <!-- 장면 — 장면은 엔티티가 아니다: 이 장면ID를 든 에피소드들의 묶음이다. 이름을
                         고치면 그 에피소드들의 장면ID가 함께 바뀐다(되돌리기 한 칸). -->
                    <StackPanel x:Name="ScenePanel" Spacing="6" IsVisible="False">
                        <TextBox x:Name="SceneNameBox" FontSize="11" PlaceholderText="장면ID — 적고 Enter"
                                 ToolTip.Tip="고치고 Enter를 누르면 이 장면의 에피소드 모두의 장면ID가 바뀝니다. 비우면 에피소드마다 제 장면(미지정)이 됩니다." />
                        <TextBlock x:Name="SceneHintText" FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        <TextBlock Text="에피소드" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                        <StackPanel x:Name="SceneEpisodesPanel" Spacing="2" />
                    </StackPanel>

                    <StackPanel x:Name="PropertyPanel" Spacing="6" IsVisible="False">
                        <!-- 에피소드의 두 칸 — 왼쪽 기둥의 이름표가 무슨 칸인지 말한다. 둘 다 고치고 Enter.
                             개명 = Id를 고치고 Enter(간선 · 픽스처 · 카드가 함께 따라간다). 장면은 여기서 정하지 않는다 —
                             하이어아키에서 에피소드를 장면 줄로 끌고, 장면 줄에서 이름을 바꾼다. -->
                        <Grid x:Name="EpisodeFieldsGrid" ColumnDefinitions="70,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Text="에피소드ID" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" FontSize="11"
                                     ToolTip.Tip="이름을 고치고 Enter를 누르면 개명됩니다 — 간선·픽스처·대본 파일·대사 노드가 함께 따라갑니다. 조건식의 cleared: 참조가 있으면 거부됩니다." />

                            <!-- 제목 — 런타임 끝 카드의 "마지막 에피소드" 줄. 비우면 내보내기가 이름을 쓴다. -->
                            <TextBlock Grid.Row="1" Text="제목" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EpisodeTitleBox" FontSize="11" PlaceholderText="비우면 에피소드ID"
                                     ToolTip.Tip="게임의 끝 카드가 '마지막 에피소드'로 보여 주는 글자입니다. 고치고 Enter. 비우면 에피소드 이름이 나갑니다." />

                        </Grid>

                        <!-- 선택지 — 이 에피소드에서 나가는 길들. 길 하나 = 선택지 하나.
                             줄을 클릭하면 그 줄 바로 아래에서 문구와 도착을 고친다. 문구는 글자 칸에 직접 적는다(적은
                             문구는 챕터의 선택지 사전에 남는다). 여기서는 길을 더하거나 끊지 않는다 — 선택지를 잇고 끊는 것은
                             [대본] 탭(카드 아래 칸)에서 한다. -->
                        <TextBlock x:Name="ChoiceHeaderText" Text="선택지" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,10,0,0" />
                        <!-- 선택지 줄 — 누르면 그 줄 아래에 문구 · 도착 · 조건 · 스탯변화가 펼쳐진다(읽기 전용). 다시 누르면 접힌다. -->
                        <StackPanel x:Name="EdgeListPanel" Spacing="3" />

                        <!-- 대사 미리보기 — 선택지 아래에 접어 둔다. 에피소드 노드만으로는 정보가
                             모자라서다. 원천은 그 에피소드 카드의 대본이고,
                             고치는 곳은 연출 그래프 카드의 글 칸이다. -->
                        <!-- 대사 — 상자를 겹치지 않는다.
                             Expander·테두리·안쪽 스크롤을 두지 않는다: 탭 속의 탭처럼 보이고
                             읽는 폭만 좁힌다. **얇은 구분선 + 접기 토글 + 흐르는 글**
                             뿐이고, 스크롤은 편집 탭 하나만 쓴다. 대사를 고치며 읽는 화면이라
                             가독성이 가장 위다. -->
                        <Border BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,14,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- 삼각형이 접힘/펼침을 말한다 —
                                         ▸ 접힘 · ▾ 펼침. 코드가 상태에 맞춰 글자를 바꾼다. -->
                                    <ToggleButton x:Name="DialogueToggle"
                                                  Content="▸  대사"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <!-- 켜져도 파랗게 칠하지 않는다 — 테마 기본 ToggleButton은
                                             체크되면 강조색으로 채워진다. 제목처럼 보여야 하는
                                             자리라 모든 상태에서 평평하게 둔다. -->
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1"
                                               x:Name="DialoguePreviewHeader"
                                               FontSize="10"
                                               Opacity="0.55"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- 한 덩어리로 흐르는 글. 화자는 줄 앞에 그대로 붙는다
                                     (`윌로: 복도는 조용했다`) — 줄마다 카드로 가르면
                                     읽기가 오히려 나빠진다. -->
                                <SelectableTextBlock x:Name="DialoguePreviewText"
                                                     FontSize="12"
                                                     LineHeight="20"
                                                     TextWrapping="Wrap"
                                                     IsVisible="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 길(간선) 편집 — 그래프에서 선을 클릭하면 여기가 열린다. 선택지형 VN의
                         "이 선택지는 언제 보이고 언제 열리는가"를 여기서 정한다. -->
                    <StackPanel x:Name="EdgePanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="선택지가 가는 길" FontWeight="SemiBold" FontSize="12" />
                        <!-- 양 끝 에피소드는 누를 수 있다 — 간선을 보다가 "저 에피소드 이름을
                             고쳐야겠다"가 되는 흐름이 실제 저작의 대부분이다. -->
                        <StackPanel x:Name="EdgeFromToPanel" Orientation="Horizontal" Spacing="4" />

                        <TextBlock Text="선택지 — 이 길에 붙는 문구" FontSize="10" Opacity="0.6" />
                        <TextBox x:Name="EdgeLabelEditBox" FontSize="11" HorizontalAlignment="Stretch"
                                 PlaceholderText="선택지 문구"
                                 ToolTip.Tip="문구를 직접 적습니다 — Enter나 다른 곳을 누르면 저장됩니다. 일반 선택지는 문구가 필수입니다." />

                        <!-- 자동 진행 길이면 그렇다고 말하고 칸을 잠근다 — 자동 길은 문구 · 조건 · 스탯변화를 갖지 않는다.
                             자동인지는 여기서 정하지 않는다([대본] 탭에서 문구 없이 이은 길이다). -->
                        <TextBlock x:Name="EdgeAutoNote" FontSize="10" Opacity="0.7" TextWrapping="Wrap" IsVisible="False"
                                   Text="자동 진행 길입니다 — 플레이어 입력 없이 넘어갑니다. 문구 · 조건 · 스탯변화를 갖지 않습니다." />

                        <TextBlock Text="표시조건 — 이 선택지가 보이려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeVisibleCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="미달이면 선택지가 목록에 아예 안 뜹니다. 비우면 언제나 보입니다." />

                        <TextBlock Text="해금조건 — 보이지만 고를 수 있으려면" FontSize="10" Opacity="0.6" />
                        <ComboBox x:Name="EdgeConditionCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="미달이면 잠긴 채 보이고 아래 안내문이 뜹니다. 아예 안 보이게 하려면 그 조건을 위의 표시조건에 적으세요." />

                        <!-- [해금 미달이면 숨김] 체크는 두지 않는다. 같은 말을 두 번 하는 칸이다 —
                             해금조건 + 숨김은 그 식을 **표시조건**에 적은 것과 결과가 같다.
                             개념이 둘이면 작가가 어느 쪽으로 적었는지에 따라 같은 이야기가
                             다르게 보인다. -->
                        <TextBox x:Name="EdgeLockedMsgBox" FontSize="11"
                                 PlaceholderText="잠금 안내문 — 잠긴 채 보일 때 (예: 신뢰가 부족하다)" />

                        <!-- 스탯이 변하는 유일한 자리 — 이 간선을 타는 순간 1회 커밋.
                             문법을 외우는 칸이 아니라 고르는 줄이다. 스탯은
                             챕터에 선언한 것([챕터] 탭의 스탯 표)만 드롭다운에 온다. -->
                        <TextBlock Text="스탯변화 — 이 길을 고르면" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <StackPanel x:Name="EdgeStatsHost" Spacing="3" />

                        <!-- [적용] 단추는 없다 — 누르지 않아도 바로 반영된다. 고르는 순간 그 셀이 써진다 — 글자 칸만
                             초점을 잃거나 Enter일 때 낸다. -->
                        <!-- 길을 끊거나 자동으로 바꾸는 것은 여기서 하지 않는다 — 선택지를 잇고 끊는 것은 [대본] 탭이다. -->
                        <TextBlock Text="고치면 그 자리에서 저장됩니다."
                                   FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 분기 — 선택지와 <b>다른 종류</b>다. 조작을 단순하게 두려고 문구도
                         스탯변화도 없다.

                         여기서 <b>표식을 만들거나 떼지 않는다</b> — 뚫고 떼는 것은 연출
                         그래프의 일이다. 이 패널이 쓰는 것은 다녀올 에피소드의 첫머리 조건
                         하나뿐이다. -->
                    <StackPanel x:Name="BranchPanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="분기 — 반드시 한 번 다녀오는 통로" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="BranchFromToPanel" Orientation="Horizontal" Spacing="4" />

                        <TextBlock Text="이 조건일 때 분기의 내용이 돈다" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <ComboBox x:Name="BranchConditionCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="분기로는 언제나 한 번 갑니다 — 막는 것은 다녀온 쪽입니다. 조건이 미달이면 그 에피소드가 아무것도 재생하지 않고 곧바로 돌아옵니다. 비우면 언제나 재생됩니다." />

                        <TextBlock x:Name="BranchBlockedText"
                                   FontSize="10"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />

                        <TextBlock Text="조건은 다녀갈 에피소드의 첫머리에 적힙니다 — 부르는 쪽 대본은 그대로입니다."
                                   FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 빈 선택지 칸 — 카드 아래의 빈 점을 누르면 선다. 아직 이 칸에서 나가는 길이 없다. -->
                    <StackPanel x:Name="SlotPanel" Spacing="6" IsVisible="False">
                        <TextBlock x:Name="SlotTitleText" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="SlotFromPanel" Orientation="Horizontal" Spacing="4" />
                        <TextBlock x:Name="SlotDetailText" FontSize="10" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                <!-- 화자 — 하이어아키의 프로젝트 줄. 프로젝트 전체의 캐스트다. 여기서 더한 화자는
                     게임 project에 저장되며, 모든 챕터가 공유해서 쓴다.

                     주의: 이 자리가 유일한 등록 창구이고, 값은 game.definition.json의 speakers에 산다. -->
                    <ScrollViewer x:Name="SpeakerSection"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="4">
                            <TextBlock x:Name="SpeakerHintText"
                                       Text="모든 챕터가 같은 목록을 씁니다 — game.definition.json에 저장됩니다. 캐릭터키를 채우면 초상화·표정이 붙습니다(비워도 됩니다)."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <!-- 한 줄 폼 — 선택지 폼과 같은 규칙이다. -->
                            <Grid ColumnDefinitions="*,*,Auto">
                                <TextBox x:Name="SpeakerNameBox"
                                         Grid.Column="0"
                                         FontSize="12"
                                         PlaceholderText="이름" />
                                <TextBox x:Name="SpeakerCharacterIdBox"
                                         Grid.Column="1"
                                         Margin="6,0,0,0"
                                         FontSize="12"
                                         PlaceholderText="캐릭터키 (선택)" />
                                <Button x:Name="SpeakerAddButton"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        FontSize="11"
                                        Content="＋ 추가"
                                        ToolTip.Tip="Enter로도 더합니다. 같은 이름은 한 번만 섭니다." />
                            </Grid>

                            <StackPanel x:Name="SpeakerListPanel" Spacing="2" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                <!-- 챕터 — 하이어아키의 챕터 줄. 판 전체에 걸린 표들 — 조건과 스탯을 여기서 만들고 고친다.
                     에피소드·간선은 그래프가 이미 그리므로 여기 반복하지 않는다. -->
                    <ScrollViewer x:Name="ChapterSection"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConditionSection" Margin="10" Spacing="4">
                            <!-- 표시 이름 — 진행 JSON의 DisplayName, 게임 끝 카드의 머리. 비우면 챕터 Id. -->
                            <TextBox x:Name="ChapterDisplayNameBox" FontSize="11" PlaceholderText="표시 이름 (비우면 챕터 Id)"
                                     Margin="0,0,0,10"
                                     ToolTip.Tip="게임의 끝 카드 머리에 뜨는 챕터 이름입니다. 고치고 Enter. 신원이 아니라 글자라 바꿔도 저장·간선이 따라가지 않습니다." />
                            <!-- 조건은 툴에서 편집한다. -->
                            <TextBlock Text="조건 (라벨 ↔ 식)"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBlock Text="라벨과 식을 여기서 고칩니다 — 식은 `trust >= 3` 꼴이고 `;`가 AND, 예/아니오 스탯은 `열쇠 == true`입니다. 고친 값은 그 자리에서 챕터에 저장됩니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <StackPanel x:Name="ConditionListPanel" Spacing="2" />

                            <TextBlock Text="스탯"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,14,0,0" />
                            <!-- 조건 줄과 같은 결로 적는다 — 두 표가 같은 자리에 서 있으니
                                 "어디서 고치나"의 대답도 같은 모양이어야 눈이 한 번에 읽는다. -->
                            <TextBlock Text="여기서 만들고 고칩니다. 종류는 둘입니다 — 숫자(호감도 · 점수처럼 오르내리는 값: 처음 값 · 최소 · 최대)와 예/아니오(했다 · 안 했다처럼 켜고 끄는 값: 처음 값만). ⚠ 왼쪽의 [키]는 세이브의 열쇠라 [✎]로 바꾸면 이미 저장된 회차의 그 스탯이 처음 값으로 떨어집니다 — 화면 글자만 고칠 때는 [표시 이름] 칸을 쓰세요. 지우기[✕]는 쓰는 곳이 있으면 어디인지 보여 주고 한 번 더 묻습니다."
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="StatListPanel" Spacing="2" />
                        </StackPanel>
                    </ScrollViewer>
                    </Panel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <!-- 검증 보고는 <b>늘 서 있되 작아야 한다</b> — 원할 때 언제든 확인할 수
                 있어야 하지만 시각적으로 크게 보일 필요는 없다.

                 Fluent의 Expander 머리글은 최소 48px이라, 접혀 있어도 판 아래를 그만큼
                 늘 먹는다.

                 주의: <b>Style로는 못 줄인다.</b> 그 48은 템플릿 안에서 토글에 직접 박히는
                 값(로컬 값)이라 스타일 세터가 못 이긴다(높이가 48 그대로).
                 대신 템플릿이 쳐다보는 <b>리소스를 이 자리에서 갈아 끼운다.</b> 범위는
                 이 Expander 안뿐이라 다른 화면은 그대로다.

                 주의: 줄이는 것은 <b>머리글뿐</b>이다. 펼친 목록의 글자는 그대로여야 한다 —
                 거기는 기획자가 실제로 읽고 좌표를 짚는 자리다(줄들이 제 FontSize를
                 직접 들고 있어 이 FontSize가 그 위를 덮지 않는다). -->
            <Expander x:Name="DiagnosticsExpander"
                      Header="검증 보고"
                      Padding="0"
                      FontSize="11"
                      HorizontalAlignment="Stretch">
                <Expander.Resources>
                    <x:Double x:Key="ExpanderMinHeight">26</x:Double>
                    <Thickness x:Key="ExpanderHeaderPadding">10,2</Thickness>
                    <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                </Expander.Resources>
                <Grid RowDefinitions="Auto,*">
                    <!-- 보고를 그대로 들고 나갈 수 있어야 한다 — 협업자·세션에 붙여넣는 용도. -->
                    <Button Grid.Row="0"
                            x:Name="CopyDiagnosticsButton"
                            Content="보고 복사"
                            FontSize="10"
                            Padding="8,2"
                            Margin="10,4,10,0"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="아래 목록 전체를 클립보드로 복사합니다. 줄 하나만 필요하면 드래그로 선택해도 됩니다." />
                    <!-- AllowAutoHide=False — 목록이 길 때 "아래 더 있다"가 보여야 한다.
                         숨는 오버레이 스크롤바는 동기화 보고가 묻혀 있다는 사실 자체를 숨겼다(실사례). -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel x:Name="DiagnosticsPanel" Margin="10,6" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
