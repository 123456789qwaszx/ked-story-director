<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:Vn.App.Strings"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.ChapterGraphView">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 툴바 위아래 여백 4 — 위 띠 · 탭 줄과 붙인다(2026-11-18 소유자 · chrome-card-header U1, ⛔ 그 전에는 8). -->
        <Border Grid.Row="0"
                Padding="10,4"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,0,0,1">
            <!-- [다시 읽기] 단추는 두지 않는다 — **화면이 저절로 따라오기 때문이다.** 판은 프로젝트에서 오고(파일을 읽지 않는다),
                 프로젝트가 바뀌면 세션의 변경 알림이 다시 읽기를 부른다(QueueReload). -->
            <Grid>
                <!-- 주의: 왼쪽 무리는 <b>연출 그래프 툴바와 한 쌍</b>이다.
                     같은 StackPanel(Spacing=6) · 같은 라벨 여백 · 콤보 뒤 같은 구분선.
                     짝: `GraphEditorView.axaml`의 툴바 — 한쪽을 고치면 둘 다 고친다.
                     (콤보 치수가 한 쌍인 것도 같은 이유다.) -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Static s:Ui.Board_Chapter2}"
                               FontSize="11"
                               Opacity="0.6"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0" />
                    <ComboBox x:Name="ChapterCombo" MinWidth="180" FontSize="11" />
                    <!-- [내보내기] 단추는 두지 않는다.
                         챕터 진행 JSON이 사람 손을 기다리면 누른 순간의 낡은 파일이 디스크에
                         남는다. 다시 읽을 때마다 저절로 나간다 — 내보내기의 거부 규칙은 그대로 적용된다. -->
                    <Border Width="1" Margin="4,2" Background="{DynamicResource Divider}" />
                    <!-- [＋ 에피소드] 단추는 두지 않는다 — [구성] 탭에서는 에피소드를 더하지 않는다(하이어아키도 읽기 전용). 에피소드는 [대본] 탭의
                         [＋ 에피소드] · 하이어아키 장면 줄 우클릭 「에피소드 추가」로 더한다. -->

                    <!-- 자동 정렬 — 자리의 주인이 사람이라서
                         필요한 짝이다. 손으로 옮기다 판이 엉키면 되돌릴 길이 있어야 한다.
                         연출 그래프의 카드 자리를 본뜬다(`ChapterBranchPlanner.LayoutLikeBoard`).
                         주의: 한 번의 변경이라 Ctrl+Z 한 번이면 옮기기 전으로 돌아온다. -->
                    <Button x:Name="AutoArrangeButton"
                            Content="{x:Static s:Ui.Structure_AutoLayout}"
                            ToolTip.Tip="{x:Static s:Ui.Structure_ReLaysOutEveryCard}" />
                    <!-- 화면 맞춤 — 화면(배율 · 스크롤)만 맞춘다. 카드 자리는 그대로다. ⛔ 2026-11-18까지 이름이 「전체 보기」였다(소유자). -->
                    <Button x:Name="FitChapterButton"
                            Content="{x:Static s:Ui.Structure_FitToScreen}"
                            ToolTip.Tip="{x:Static s:Ui.Structure_SetsZoomAndPositionSo}" />
                    <Border Width="1" Margin="4,2" Background="{DynamicResource Divider}" />
                    <!-- 빈 선택지 숨기기 — [구성] 판 전체에 하나다. [대본] 탭은 카드마다 인스펙터의 체크로 정한다. -->
                    <CheckBox x:Name="HideEmptyChoicesCheck" Content="{x:Static s:Ui.Dialogue_HideEmptyChoices}" FontSize="11" VerticalAlignment="Center"
                              ToolTip.Tip="{x:Static s:Ui.Structure_WhenOnHidesUnconnectedEmpty}" />
                    <!-- ID로 보기 — 켜면(처음) 하이어아키 · 카드가 ID로, 끄면 [대본] 탭처럼 이름으로 선다(2026-11-18 소유자). 앱 설정에 기억한다. -->
                    <CheckBox x:Name="ShowIdsCheck" Content="{x:Static s:Ui.Structure_ShowIDs}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"
                              ToolTip.Tip="{x:Static s:Ui.Structure_WhenOnHierarchyAndCards}" />
                </StackPanel>

                <!-- 픽스처(재생루트 하이라이트)는 화면에 세우지 않는다.
                     주의: 챕터의 픽스처와 `ChapterFixtureWalker`는 남아 있다 — 화면만 없으므로
                     다시 보이려면 콤보와 걷기 호출을 세우면 된다. -->

                <!-- 에피소드를 지우는 단추는 두지 않는다 — [구성] 탭은 지우지 않는다(하이어아키도 읽기 전용). 지우기는 [대본] 탭에서 한다
                     (툴바 [삭제] · Delete 키 · 하이어아키 우클릭). -->
            </Grid>
        </Border>

        <!-- 인스펙터 폭 340 — 조건 식·대사 미리보기가 300에서는 줄바꿈으로 부서진다. -->
        <Grid Grid.Row="1" x:Name="BoardColumns">
            <!-- 하이어아키 · 판 · 인스펙터 — 유니티와 같은 차례. 하이어아키 폭은 사람이 끈다(최소 140 —
                 0까지 끌어 사라지면 다시 잡을 손잡이가 없다). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!-- 하이어아키: 프로젝트 → 챕터 → 장면 → 에피소드를
                 유니티 하이어아키처럼 접었다 편다. 이 탭에서는 <b>읽기 전용</b>이다 — 고르기 · 접기만 되고 우클릭 차림표 · 이름 고치기 ·
                 끌어 옮기기가 없다(ReadOnly — 더하고 지우고 고치는 것은 [대본] 탭).
                 판 <b>왼쪽 기둥</b>이다 — 유니티처럼
                 하이어아키 · 판 · 인스펙터가 왼쪽에서 오른쪽으로 선다. 폭은 오른쪽 스플리터로 사람이 정한다.
                 주의: 줄을 고른 뒤의 일(챕터 · 에피소드 고르기, 오른쪽 탭 바꾸기)은 이 뷰가, 내용(프로젝트 · 챕터 목록)과
                 접힘은 셸(MainWindow)이 짓는다 — 두 탭의 하이어아키가 한 원천 · 한 접힘을 쓴다. -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,1,0">
                <Panel>
                <Grid x:Name="HierarchyOpen" RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,0,0,1">
                        <!-- 새 챕터는 여기서 만들지 않는다 — [대본] 탭의 하이어아키 · 판 우클릭 「챕터 추가」로 만든다. 챕터가 하나도 없으면 두 탭의 판 한가운데
                             [＋ 첫 챕터 만들기]가 선다(이 탭의 것은 [대본]으로 데려가 거기서 만든다 — first-chapter F2). -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Static s:Ui.Keys_Hierarchy}" FontWeight="SemiBold" />
                                <TextBlock x:Name="ChapterSummary"
                                           FontSize="11"
                                           Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    x:Name="FoldHierarchyButton"
                                    Content="‹"
                                    FontSize="12"
                                    Padding="7,0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    ToolTip.Tip="{x:Static s:Ui.Board_CollapseHierarchyBoardGetsWider}" />
                        </Grid>
                    </Border>

                    <views:StoryHierarchy Grid.Row="1" x:Name="Hierarchy" />
                </Grid>

                    <!-- 접힌 하이어아키 — 세로 띠 하나. 누르면 편다(HierarchyDock). -->
                    <Button x:Name="HierarchyStrip"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Top"
                            Padding="0,6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="{x:Static s:Ui.Board_ExpandHierarchy}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="›" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <LayoutTransformControl>
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock Text="{x:Static s:Ui.Keys_Hierarchy}" FontSize="11" Opacity="0.7" />
                            </LayoutTransformControl>
                        </StackPanel>
                    </Button>
                </Panel>
            </Border>

            <GridSplitter Grid.Column="1"
                          x:Name="HierarchySplitter"
                          ResizeDirection="Columns"
                          Background="{DynamicResource Divider}" />

            <Grid Grid.Column="2">
                <!-- 휠 확대·축소(Ctrl 없이) / 가운데 단추 끌어 이동.
                     연출 그래프와 같은 손놀림이다 — 판이 둘인데 다루는 법이 다르면
                     손이 매번 헷갈린다. 배율은 ZoomHost의 LayoutTransform이 진다:
                     캔버스 좌표(배치·간선 산식)는 배율을 몰라도 된다. -->
                <ScrollViewer x:Name="GraphScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <!-- 판 바깥(BoardDesk) — 보이는 칸을 늘 채우는 회색 바탕이다. 판(GraphCanvas · 흰 바탕)이 그 위에 선다 — 판 안과 밖이 눈에
                         보인다(2026-11-19 소유자 · usability UX22). 빈 곳 누르기 · 끌기 · 놓기는 이 바탕이 받는다 — 판 둘레를 눌러 끌어도 범위
                         고르기가 된다(⛔ 판 밖은 받을 주인이 없어 손짓이 막혔다).
                         판이 화면보다 작으면(화면 맞춤 · 작은 챕터) 판을 띄워 화면 가운데에 둔다 — 띄움(Margin)은 코드가 정한다(PlaceSheet:
                         처음 · 챕터를 바꿀 때 · 화면 맞춤 · 배율에 가운데로, 편집으로 판 크기가 바뀌면 왼위 그대로 — ⛔ 정렬로 늘 가운데에 두면
                         판이 넓어질 때마다 그 반만큼 비켜 서 놓은 카드가 밀렸다 · UX22). 배율 칸은 판 크기 그대로 서야 한다 — 늘어나 화면을 채우면
                         그 안에서 판을 가운데로 미는 거리가 배율로 줄지 않아, 판이 오른쪽 · 아래로 밀려 잘렸다(⛔ 2026-11-19까지 · usability UX10 —
                         [대본] 판의 같은 뿌리는 writer-comfort WC1에서 왼위에 붙여 고쳤다).
                         배율 칸은 판 밖을 자르지 않는다 — 범위 사각형 · 판 밖으로 끄는 카드가 바깥에서도 보인다(⛔ 잘려 사라져 보였다 · UX22). -->
                    <Panel x:Name="BoardDesk" Background="{DynamicResource StructureDesk}">
                        <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
                            <Canvas x:Name="GraphCanvas" Background="{DynamicResource Surface}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </LayoutTransformControl>
                    </Panel>
                </ScrollViewer>

                <!-- 배율 표시 — 100%가 아닐 때만. 누르면 100%로 돌아온다. -->
                <Button x:Name="ZoomResetButton"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,18"
                        Padding="8,3"
                        FontSize="11"
                        IsVisible="False"
                        ToolTip.Tip="{x:Static s:Ui.Structure_ResetsZoomTo100Zoom}">
                    <TextBlock x:Name="ZoomText" />
                </Button>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="12">
                    <TextBlock x:Name="EmptyText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Opacity="0.55"
                               TextWrapping="Wrap"
                               MaxWidth="420" />
                    <!-- 빈 판의 첫걸음 — 프로젝트가 아직 없으면 [새 프로젝트]가 판 한가운데 선다(배선은 셸: File 메뉴의
                         「새 프로젝트…」와 같은 길). 프로젝트는 있고 챕터가 없으면 [＋ 첫 챕터 만들기] — [대본] 탭으로 데려가 거기서 만든다
                         (2026-11-18 소유자 · first-chapter F2 · ⛔ 그 전에는 이 탭에 챕터 단추를 두지 않고 안내문만 [대본]으로 데려갔다). -->
                    <Button x:Name="EmptyFirstChapterButton"
                            Content="{x:Static s:Ui.Board_CreateFirstChapter}"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            IsVisible="False"
                            ToolTip.Tip="{x:Static s:Ui.Structure_GoesToScriptTabAnd}" />
                    <Button x:Name="EmptyNewProjectButton"
                            Content="{x:Static s:Ui.Main_NewProject}"
                            HorizontalAlignment="Center"
                            Padding="16,6"
                            IsVisible="False"
                            ToolTip.Tip="{x:Static s:Ui.Structure_CreatesAndSavesNewProject}" />
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="3"
                          x:Name="SideSplitter"
                          ResizeDirection="Columns"
                          Background="{DynamicResource Divider}" />

            <!-- 오른쪽 기둥 — 탭 셋(인스펙터 · 화자 · 조건 및 스탯)이고 접힌다. 챕터 구조의 편집은 여기서, 대사는 연출 그래프의 카드에서.
                 모든 편집은 프로젝트를 고치고, 변경 알림이 그래프를 다시 그린다. -->
            <Grid Grid.Column="4" x:Name="ChapterRightRows">

                <!-- 오른쪽 기둥 = 탭 셋 — 인스펙터 · 화자 · 조건 및 스탯(2026-11-18 소유자 · side-tabs V1). 화자와 조건이 하이어아키의
                     줄을 골라야만 보여 처음 쓰는 사람이 찾지 못했다 — 탭으로 늘 세운다. ⛔ 그 전에는 탭 없이 고른 것이 내용을 정했다.
                     고르면 그것을 보이는 탭으로 간다: 프로젝트 줄 → 화자, 챕터 줄 → 조건 및 스탯([구성]은 수치를 잡는 자리다), 그 밖 →
                     인스펙터. 콤보로 챕터를 바꾸는 것은 탭을 바꾸지 않는다. 탭은 언제든 손으로 연다. -->
                <Panel x:Name="SideOpen">
                <!-- 흐린 안내글은 views:GuideLine이다 — 설정 「기타」의 「설명 간소화」를 켜면 숨거나(짧은 꼴이 없으면) 짧은 꼴로 선다
                     (2026-11-18 소유자 · brief-guides G1). 칸 이름 · 제목 · 경고는 TextBlock 그대로다. -->
                <TabControl x:Name="SideTabs" Padding="0">
                    <TabControl.Styles>
                        <!-- 탭 글은 작게 — 테마 기본(큰 글 · 48 높이)은 판의 [구성] · [대본] 탭과 같은 무게라 기둥 안에서는 너무 크다. -->
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="10,2" />
                        </Style>
                    </TabControl.Styles>

                <TabItem x:Name="InspectorTabItem" Header="{x:Static s:Ui.Board_Inspector}">
                <!-- 인스펙터: 하이어아키나 판에서 고른 것을 보인다. 장면 → 장면ID, 에피소드 · 선택지(길) · 분기 → 그 편집, 챕터 →
                     챕터ID, 프로젝트 → 옆 탭 안내. 머리글이 무엇을 보는지 말한다. -->
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="1">
                            <!-- 줄을 넘긴다 — 선택지 간선은 문구가 머리글이다(2026-11-17), 긴 문구도 다 보여야 한다. -->
                            <TextBlock x:Name="InspectorTitle" Text="{x:Static s:Ui.Board_Inspector}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="InspectorSubtitle"
                                       FontSize="11"
                                       Opacity="0.65"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <Panel Grid.Row="1">
                    <!-- 고른 하나 — 에피소드 · 선택지(길) · 분기, 그리고 장면. -->
                    <ScrollViewer x:Name="SelectionSection"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="6">
                    <TextBlock x:Name="NoSelectionText"
                               Text="{x:Static s:Ui.Structure_ClickNodeSelectClickLine}"
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap" />

                    <!-- 장면 — 장면은 엔티티가 아니다: 이 장면ID를 든 에피소드들의 묶음이다. 이름은 머리글이 보이고, 고치는
                         것은 [대본] 탭(하이어아키의 장면 줄 · 인스펙터 머리의 이름 칸)이다 — 보이는 이름만 바뀌고 장면ID는 그대로다. 장면ID는
                         아래 칸에서 고친다. -->
                    <StackPanel x:Name="ScenePanel" Spacing="6" IsVisible="False">
                        <!-- 장면ID 칸 — 런타임 저장 · 롤백 경계. 고치고 Enter(RenameScene — 장면 이름 · 메모가 함께 간다). 장면 이름은
                             [대본] 탭에서 고친다(display-names N4). -->
                        <Grid x:Name="SceneIdGrid" ColumnDefinitions="70,*">
                            <TextBlock Text="{x:Static s:Ui.Structure_SceneID}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="SceneIdBox" FontSize="11"
                                     ToolTip.Tip="{x:Static s:Ui.Structure_EditAndPressEnterTo}" />
                        </Grid>
                        <views:GuideLine x:Name="SceneHintText" FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Static s:Ui.Structure_Episode}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                        <StackPanel x:Name="SceneEpisodesPanel" Spacing="2" />
                    </StackPanel>

                    <StackPanel x:Name="PropertyPanel" Spacing="6" IsVisible="False">
                        <!-- 에피소드ID 칸 — 왼쪽 기둥의 이름표가 무슨 칸인지 말한다. 개명 = Id를 고치고 Enter(간선 · 픽스처 ·
                             카드가 함께 따라간다). 제목은 머리글(「장면 - 제목」)이 보이고 [대본] 탭에서 고친다. 장면은 여기서
                             정하지 않는다 — 하이어아키에서 에피소드를 장면 줄로 끌고, 장면 줄에서 이름을 바꾼다. -->
                        <Grid x:Name="EpisodeFieldsGrid" ColumnDefinitions="70,*" RowDefinitions="Auto">
                            <TextBlock Grid.Row="0" Text="{x:Static s:Ui.Structure_EpisodeID}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="IdBox" FontSize="11"
                                     ToolTip.Tip="{x:Static s:Ui.Structure_ChangesWhenYouPressEnter}" />
                        </Grid>

                        <!-- 선택지 — 이 에피소드에서 나가는 길들. 길 하나 = 선택지 하나. 줄이 문구와 도착을 보인다.
                             여기서는 길을 더하거나 끊지 않는다 — 선택지를 잇고 끊는 것은 [대본] 탭(카드 아래 칸)에서 한다. -->
                        <TextBlock x:Name="ChoiceHeaderText" Text="{x:Static s:Ui.Board_Choice}" FontWeight="SemiBold" FontSize="12"
                                   Margin="0,10,0,0" />
                        <!-- 선택지 줄 — 누르면 그 줄 아래에 조건 · 스탯변화가 펼쳐진다(읽기 전용). 다시 누르면 접힌다. -->
                        <StackPanel x:Name="EdgeListPanel" Spacing="3" />

                        <!-- 대사 미리보기 — 선택지 아래에 접어 둔다. 에피소드 노드만으로는 정보가
                             모자라서다. 원천은 그 에피소드 카드의 대본이고,
                             고치는 곳은 연출 그래프 카드의 글 칸이다. -->
                        <!-- 대사 — 상자를 겹치지 않는다.
                             Expander·테두리·안쪽 스크롤을 두지 않는다: 탭 속의 탭처럼 보이고
                             읽는 폭만 좁힌다. **얇은 구분선 + 접기 토글 + 흐르는 글**
                             뿐이고, 스크롤은 편집 탭 하나만 쓴다. 대사를 고치며 읽는 화면이라
                             가독성이 가장 위다. -->
                        <Border BorderBrush="{DynamicResource Divider}"
                                BorderThickness="0,1,0,0"
                                Margin="0,14,0,0"
                                Padding="0,10,0,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- 삼각형이 접힘/펼침을 말한다 —
                                         ▸ 접힘 · ▾ 펼침. 코드가 상태에 맞춰 글자를 바꾼다. -->
                                    <ToggleButton x:Name="DialogueToggle"
                                                  Content="{x:Static s:Ui.Structure_Dialogue2}"
                                                  FontSize="12"
                                                  FontWeight="SemiBold"
                                                  Padding="0"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Cursor="Hand">
                                        <!-- 켜져도 파랗게 칠하지 않는다 — 테마 기본 ToggleButton은
                                             체크되면 강조색으로 채워진다. 제목처럼 보여야 하는
                                             자리라 모든 상태에서 평평하게 둔다. -->
                                        <ToggleButton.Styles>
                                            <Style Selector="ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                            <Style Selector="ToggleButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
                                            </Style>
                                        </ToggleButton.Styles>
                                    </ToggleButton>
                                    <views:GuideLine Grid.Column="1"
                                               x:Name="DialoguePreviewHeader"
                                               FontSize="10"
                                               Opacity="0.55"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <!-- 한 덩어리로 흐르는 글. 화자는 줄 앞에 그대로 붙는다
                                     (`윌로: 복도는 조용했다`) — 줄마다 카드로 가르면
                                     읽기가 오히려 나빠진다. -->
                                <SelectableTextBlock x:Name="DialoguePreviewText"
                                                     FontSize="12"
                                                     LineHeight="20"
                                                     TextWrapping="Wrap"
                                                     IsVisible="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 길(간선) 편집 — 그래프에서 선을 클릭하면 여기가 열린다. 선택지형 VN의
                         "이 선택지는 언제 보이고 언제 열리는가 · 고르면 무엇이 변하는가"를 여기서 정한다.

                         2026-11-17 소유자: [구성]은 수치를 잡는 자리다 — 조건이 위, 그 조건의 식(수치)을 콤보 바로 아래에서 고친다.
                         양 끝 에피소드 고리는 걷었다. 문구는 머리글에 선다(「선택지 · 문구」, 부제는 양 끝 에피소드의 제목) —
                         ⛔ 같은 날 둔 읽기 전용 문구 칸과 「고치는 곳」 안내는 고칠 수 있는 칸처럼 보여 걷었다(소유자). -->
                    <StackPanel x:Name="EdgePanel" Spacing="6" IsVisible="False">

                        <!-- 자동 진행 길이면 그렇다고 말하고 칸을 잠근다 — 자동 길은 문구 · 조건 · 스탯변화를 갖지 않는다.
                             자동인지는 여기서 정하지 않는다([대본] 탭에서 문구 없이 이은 길이다). -->
                        <TextBlock x:Name="EdgeAutoNote" FontSize="10" Opacity="0.7" TextWrapping="Wrap" IsVisible="False"
                                   Text="{x:Static s:Ui.Structure_AutoPathMovesOnWithout}" />

                        <TextBlock Text="{x:Static s:Ui.Side_Conditions}" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="{x:Static s:Ui.Structure_ShowConditionThisChoiceShows}" FontSize="10" Opacity="0.6" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="EdgeVisibleCombo" FontSize="11" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static s:Ui.Structure_IfNotMetChoiceDoesn}" />
                            <Button x:Name="EdgeVisibleNewButton" Grid.Column="1" Content="{x:Static s:Ui.Structure_NewCondition2}" FontSize="10"
                                    Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static s:Ui.Structure_CreatesNameAndExpressionAt}" />
                        </Grid>
                        <StackPanel x:Name="EdgeVisibleExpressionHost" Spacing="2" />

                        <TextBlock Text="{x:Static s:Ui.Structure_UnlockConditionCanBePicked}" FontSize="10" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Grid ColumnDefinitions="*,Auto">
                            <ComboBox x:Name="EdgeConditionCombo" FontSize="11" HorizontalAlignment="Stretch"
                                      ToolTip.Tip="{x:Static s:Ui.Structure_IfNotMetItS}" />
                            <Button x:Name="EdgeUnlockNewButton" Grid.Column="1" Content="{x:Static s:Ui.Structure_NewCondition2}" FontSize="10"
                                    Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center"
                                    ToolTip.Tip="{x:Static s:Ui.Structure_CreatesNameAndExpressionAt2}" />
                        </Grid>
                        <StackPanel x:Name="EdgeUnlockExpressionHost" Spacing="2" />

                        <!-- [해금 미달이면 숨김] 체크는 두지 않는다. 같은 말을 두 번 하는 칸이다 —
                             해금조건 + 숨김은 그 식을 **표시조건**에 적은 것과 결과가 같다.
                             잠금 안내문은 해금조건에 딸린 칸이라 해금조건을 걸었을 때만 그 아래에 선다. -->
                        <TextBox x:Name="EdgeLockedMsgBox" FontSize="11" Margin="12,0,0,0"
                                 PlaceholderText="{x:Static s:Ui.Structure_LockedHintShownWhileLocked}" />

                        <!-- 스탯이 변하는 유일한 자리 — 이 간선을 타는 순간 1회 커밋.
                             문법을 외우는 칸이 아니라 고르는 줄이다. 스탯은
                             챕터에 선언한 것(「조건 및 스탯」 탭의 스탯 표)만 드롭다운에 온다. -->
                        <TextBlock Text="{x:Static s:Ui.Structure_StatChangeWhenThisPath}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,0" />
                        <StackPanel x:Name="EdgeStatsHost" Spacing="3" />

                        <!-- [적용] 단추는 없다 — 고르는 순간 반영된다. 글자 칸만 초점을 잃거나 Enter일 때 낸다.
                             길을 끊거나 자동으로 바꾸는 것은 여기서 하지 않는다 — 선택지를 잇고 끊는 것은 [대본] 탭이다. -->
                        <views:GuideLine Full="{x:Static s:Ui.Structure_EditsApplyRightAwayAnd}"
                                   FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- 분기 — 선택지와 <b>다른 종류</b>다. 조작을 단순하게 두려고 문구도
                         스탯변화도 없다.

                         여기서 <b>표식을 만들거나 떼지 않는다</b> — 뚫고 떼는 것은 연출
                         그래프의 일이다. 이 패널이 쓰는 것은 다녀올 에피소드의 첫머리 조건
                         하나뿐이다. -->
                    <StackPanel x:Name="BranchPanel" Spacing="6" IsVisible="False">
                        <TextBlock Text="{x:Static s:Ui.Structure_BranchDetourThatSAlways}" FontWeight="SemiBold" FontSize="12" />

                        <!-- 분기 카드 ID 칸 — 카드 이름(= Yarn 노드 이름). 고치고 Enter. 부르는 쪽은 노드 Id로 이으므로 이름만 바뀐다.
                             제목(머리글)은 [대본] 탭에서 고친다(2026-11-17 · auto-id-orders I4). -->
                        <Grid x:Name="BranchIdGrid" ColumnDefinitions="80,*">
                            <TextBlock Text="{x:Static s:Ui.Structure_BranchCardID}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" x:Name="BranchIdBox" FontSize="11"
                                     ToolTip.Tip="{x:Static s:Ui.Structure_BranchCardSIDGame}" />
                        </Grid>
                        <WrapPanel x:Name="BranchFromToPanel" Orientation="Horizontal" ItemSpacing="4" LineSpacing="2" />

                        <TextBlock Text="{x:Static s:Ui.Structure_BranchCardSContentPlays}" FontSize="10" Opacity="0.6" Margin="0,4,0,0" />
                        <ComboBox x:Name="BranchConditionCombo" FontSize="11" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="{x:Static s:Ui.Structure_BranchIsAlwaysVisitedOnce}" />

                        <TextBlock x:Name="BranchBlockedText"
                                   FontSize="10"
                                   Foreground="IndianRed"
                                   TextWrapping="Wrap"
                                   IsVisible="False" />

                        <views:GuideLine Full="{x:Static s:Ui.Structure_ConditionIsWrittenAtTop}"
                                   FontSize="10" Opacity="0.5" TextWrapping="Wrap" Margin="0,2,0,0" />

                        <TextBlock Text="{x:Static s:Ui.Structure_ScriptReadOnlyEditIt}" FontSize="10" Opacity="0.6" Margin="0,8,0,0" />
                        <TextBlock x:Name="BranchScriptText" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 빈 선택지 칸 — 카드 아래의 빈 점을 누르면 선다. 아직 이 칸에서 나가는 길이 없다. -->
                    <StackPanel x:Name="SlotPanel" Spacing="6" IsVisible="False">
                        <TextBlock x:Name="SlotTitleText" FontWeight="SemiBold" FontSize="12" />
                        <StackPanel x:Name="SlotFromPanel" Orientation="Horizontal" Spacing="4" />
                        <views:GuideLine x:Name="SlotDetailText" FontSize="10" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 프로젝트 · 챕터 줄 — 그 줄의 것은 옆 탭에 산다(화자 · 조건 및 스탯). 여기는 챕터ID 칸과 옆 탭 안내뿐이다. -->
                    <ScrollViewer x:Name="OverviewSection"
                                  IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="6">
                            <!-- 챕터ID 칸 — [구성] 탭은 ID를 다룬다(챕터 이름은 [대본] 탭에서 — display-names N4). 고치고 Enter면
                                 개명이다(ChapterRenamer — 판 · 조건 노드 · 진행 JSON 파일 이름이 함께 간다). -->
                            <Grid x:Name="ChapterIdGrid" ColumnDefinitions="70,*">
                                <TextBlock Text="{x:Static s:Ui.Structure_ChapterID}" FontSize="11" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" x:Name="ChapterIdBox" FontSize="11"
                                         ToolTip.Tip="{x:Static s:Ui.Structure_EditAndPressEnterTo2}" />
                            </Grid>
                            <views:GuideLine x:Name="OverviewText" FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    </Panel>
                </Grid>
                </TabItem>

                <!-- 화자 — 프로젝트 전체의 캐스트다. 값은 프로젝트의 화자 목록에 산다(되돌리기 한 칸).
                     이름은 [대본] 탭(작가)이 더하고 고치고 지운다. 여기는 이름마다 캐릭터 키를 잇는 자리다(writer-fields W3). -->
                <TabItem x:Name="SpeakerTabItem" Header="{x:Static s:Ui.Board_Speakers}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Static s:Ui.Board_SpeakersForWholeProject}" FontWeight="SemiBold" />
                            <views:GuideLine Full="{x:Static s:Ui.Board_EveryChapterUsesSameList}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  x:Name="SpeakerSection"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10" Spacing="4">
                            <views:GuideLine x:Name="SpeakerHintText"
                                       Full="{x:Static s:Ui.Structure_LinkCharacterKeyToEach}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,6" />

                            <StackPanel x:Name="SpeakerListPanel" Spacing="2" Margin="0,6,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </TabItem>

                <!-- 조건 및 스탯 — 챕터 단위다. 판 전체에 걸린 표들 — 조건의 식과 스탯을 여기서 정한다(조건 이름 고치기 · 지우기는 [대본] 탭 —
                     writer-fields W4). 머리가 챕터 단위임을 말하고, 오른쪽 위 작은 드롭다운이 지금 챕터를 비춘다 — 고르면 툴바 콤보로 고른 것과
                     같다(2026-11-18 소유자). 에피소드·간선은 그래프가 이미 그리므로 여기 반복하지 않는다. -->
                <TabItem x:Name="ConditionTabItem" Header="{x:Static s:Ui.Board_ConditionsStats}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static s:Ui.Board_ConditionsStatsForThisChapter}" FontWeight="SemiBold" />
                                <views:GuideLine Full="{x:Static s:Ui.Board_UsedOnlyInThisChapter}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      x:Name="ConditionChapterCombo"
                                      FontSize="11"
                                      MinHeight="24"
                                      MaxWidth="130"
                                      Padding="6,0"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Top"
                                      ToolTip.Tip="{x:Static s:Ui.Board_ChapterThisTabShowsFollows}" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  x:Name="ChapterSection"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ConditionSection" Margin="10" Spacing="4">
                            <!-- 조건의 이름과 식은 여기서 고친다 — 더하기는 표 아래 늘 서 있는 이름 칸 + [＋ 추가](writer-comfort WC4), 지우기는 [대본] 탭. -->
                            <TextBlock Text="{x:Static s:Ui.Structure_ConditionsNameExpression}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <views:GuideLine Full="{x:Static s:Ui.Structure_SetExpressionForEachCondition}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,4" />
                            <StackPanel x:Name="ConditionListPanel" Spacing="2" />

                            <TextBlock Text="{x:Static s:Ui.Structure_Stats}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Margin="0,14,0,0" />
                            <!-- 조건 줄과 같은 결로 적는다 — 두 표가 같은 자리에 서 있으니
                                 "어디서 고치나"의 대답도 같은 모양이어야 눈이 한 번에 읽는다. -->
                            <views:GuideLine Full="{x:Static s:Ui.Structure_CreateAndEditThemHere}"
                                       FontSize="10"
                                       Opacity="0.55"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="StatListPanel" Spacing="2" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                </TabItem>
                </TabControl>
                    <!-- 기둥 접기 — 탭 줄 오른쪽 끝(2026-11-18 소유자 · side-fold K1). 하이어아키의 「‹」와 같은 손짓이다(ColumnDock). -->
                    <Button x:Name="FoldSideButton"
                            Content="›"
                            FontSize="12"
                            Padding="7,0"
                            Margin="0,5,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip.Tip="{x:Static s:Ui.Board_CollapseSidePanelInspectorSpeakers}" />
                </Panel>

                <!-- 접힌 오른쪽 기둥 — 세로 띠 하나. 누르면 편다(ColumnDock). -->
                <Button x:Name="SideStrip"
                        IsVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top"
                        Padding="0,6"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="{x:Static s:Ui.Board_ExpandSidePanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="‹" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="{x:Static s:Ui.Board_InspectorSpeakersConditionsStats}" FontSize="11" Opacity="0.7" />
                        </LayoutTransformControl>
                    </StackPanel>
                </Button>

                <!-- 초점 받이 — 칼럼의 빈 곳을 누르면 글자 칸의 초점을 여기로 옮긴다. 글자 칸은 초점을 잃을 때 내므로 Enter와
                     같이 반영되고 칸이 놓인다. 빈 곳(글 · 여백)은 초점을 받지 않아서, 옮기지 않으면 칸이 초점을 쥔 채 남는다. -->
                <Border x:Name="InspectorFocusSink" Width="0" Height="0" Focusable="True"
                        IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,0">
            <!-- 검증 보고는 <b>늘 서 있되 작아야 한다</b> — 원할 때 언제든 확인할 수
                 있어야 하지만 시각적으로 크게 보일 필요는 없다.

                 Fluent의 Expander 머리글은 최소 48px이라, 접혀 있어도 판 아래를 그만큼
                 늘 먹는다.

                 주의: <b>Style로는 못 줄인다.</b> 그 48은 템플릿 안에서 토글에 직접 박히는
                 값(로컬 값)이라 스타일 세터가 못 이긴다(높이가 48 그대로).
                 대신 템플릿이 쳐다보는 <b>리소스를 이 자리에서 갈아 끼운다.</b> 범위는
                 이 Expander 안뿐이라 다른 화면은 그대로다.

                 주의: 줄이는 것은 <b>머리글뿐</b>이다. 펼친 목록의 글자는 그대로여야 한다 —
                 거기는 기획자가 실제로 읽고 좌표를 짚는 자리다(줄들이 제 FontSize를
                 직접 들고 있어 이 FontSize가 그 위를 덮지 않는다). -->
            <Expander x:Name="DiagnosticsExpander"
                      Header="{x:Static s:Ui.Structure_ValidationReport}"
                      Padding="0"
                      FontSize="11"
                      HorizontalAlignment="Stretch">
                <Expander.Resources>
                    <x:Double x:Key="ExpanderMinHeight">26</x:Double>
                    <Thickness x:Key="ExpanderHeaderPadding">10,2</Thickness>
                    <x:Double x:Key="ExpanderChevronButtonSize">20</x:Double>
                </Expander.Resources>
                <Grid RowDefinitions="Auto,*">
                    <!-- 보고를 그대로 들고 나갈 수 있어야 한다 — 협업자·세션에 붙여넣는 용도. -->
                    <Button Grid.Row="0"
                            x:Name="CopyDiagnosticsButton"
                            Content="{x:Static s:Ui.Structure_CopyReport}"
                            FontSize="10"
                            Padding="8,2"
                            Margin="10,4,10,0"
                            HorizontalAlignment="Right"
                            ToolTip.Tip="{x:Static s:Ui.Structure_CopiesWholeListBelowTo}" />
                    <!-- AllowAutoHide=False — 목록이 길 때 "아래 더 있다"가 보여야 한다.
                         숨는 오버레이 스크롤바는 동기화 보고가 묻혀 있다는 사실 자체를 숨겼다(실사례). -->
                    <ScrollViewer Grid.Row="1"
                                  MaxHeight="220"
                                  HorizontalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <StackPanel x:Name="DiagnosticsPanel" Margin="10,6" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Expander>
        </Border>
    </Grid>
</UserControl>
