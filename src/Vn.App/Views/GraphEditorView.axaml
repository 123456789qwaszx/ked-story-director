<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:Vn.App.Strings"
             xmlns:views="using:Vn.App.Views"
             x:Class="Vn.App.Views.GraphEditorView">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 툴바 위아래 여백 4 — 위 띠 · 탭 줄과 붙인다(2026-11-18 소유자 · chrome-card-header U1, ⛔ 그 전에는 8). -->
        <Border Grid.Row="0"
                Padding="10,4"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- [+ 설정 노드]는 두지 않는다 — 설정노드는 챕터마다
                     하나가 자동으로 서는 컨트롤러라, 만들고 지우는 것이 아니다. -->
                <!--
                  챕터 고르기 — 챕터 그래프의 그 드롭다운을 여기서도
                  든다. 새 노드는 <b>지금 활성인 판</b>에 서는데, 그 판이 무엇인지 이 화면에
                  보이지 않으면 "어느 챕터에 만들어졌는지" 알 수 없다. 여기서 고르면 그 판이
                  활성이 되고, 그 뒤의 [+ 에피소드]가 거기에 선다.
                  ⛔ 2026-11-18에 걷었다가 같은 날 되살렸다(소유자 — 써 보니 있는 편이 직관적이다).
                -->
                <TextBlock Text="{x:Static s:Ui.Board_Chapter2}" FontSize="11" Opacity="0.6" VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <!-- 주의: 치수는 챕터 그래프의 콤보와 <b>한 쌍</b>이다 —
                     짝: `ChapterGraphView.axaml`의 ChapterCombo. -->
                <ComboBox x:Name="ChapterCombo" MinWidth="180" FontSize="11"
                          ToolTip.Tip="{x:Static s:Ui.Board_BoardNewNodesGoOn}" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <Button x:Name="AddEpisodeButton" Content="{x:Static s:Ui.Board_Episode}" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <!-- [삭제] — 고른 것을 지운다(2026-11-18 소유자): 아무것도 안 골랐으면 꺼진 「삭제」, 챕터 · 장면 · 에피소드 · 분기 카드를 고르면 그 이름
                     (「챕터 삭제」 …). 하이어아키 차림표의 「챕터 지우기」 · 「장면 지우기」를 갈음한다. -->
                <Button x:Name="DeleteButton" Content="{x:Static s:Ui.Board_Delete}" IsEnabled="False" ToolTip.ShowOnDisabled="True" />
                <Border Width="1" Margin="4,2" Background="{DynamicResource ThemeBorderLowBrush}" />
                <!-- 작가용 글 서식 도구 막대(2026-11-22 소유자 — 한컴 · 엑셀처럼 위에서 글꼴 · 크기 · 굵게 · 기울임 · 취소선 · 색 · 정렬) — 작가가 보기 위한
                     것이라 내보내기에 나가지 않는다. 내용은 코드가 짓는다(GraphEditorView.Writer · writer-formatting). -->
                <StackPanel x:Name="WriterToolbar" Orientation="Horizontal" Spacing="2" Background="Transparent"
                            ToolTip.ShowOnDisabled="True" />
                <!-- 빈 선택지 숨기기는 툴바에 두지 않는다 — [대본] 탭은 카드마다 인스펙터(대사 편집기)의 체크로 정한다. -->
            </StackPanel>
        </Border>

        <!-- 우측 곁기둥(대사 노드 편집기)은 이 판 안에 산다 — 쓰는 화면이 여기뿐이므로
             챕터 그래프에는 안 보인다.
             주의: 자리만 이 뷰가 내주고 <b>내용은 셸이 짓는다</b>(SetSidePanel) — 편집기의
             배선이 세션·선택 전환과 얽혀 있어 뷰로 옮기면 그 배선이 두 벌이 된다. -->
        <Grid Grid.Row="1" x:Name="BoardColumns">
            <!-- 하이어아키 · 판 · 인스펙터 — 유니티와 같은 차례.
                 하이어아키 폭은 사람이 끈다(최소 140 — 0까지 끌어 사라지면 다시 잡을 손잡이가 없다). -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="140" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="460" />
            </Grid.ColumnDefinitions>

            <!-- 하이어아키 — 챕터 그래프와 같은 StoryHierarchy, 내용은 셸이 채운다. -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="0,0,1,0">
                <Panel>
                    <Grid x:Name="HierarchyOpen" RowDefinitions="Auto,*">
                        <Border Grid.Row="0"
                                Padding="10,6"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                BorderThickness="0,0,0,1">
                            <!-- ⛔ 머리의 [＋](새 챕터)는 2026-11-18에 걷혔다(소유자). 새 챕터는 하이어아키 · 판의 챕터 밖 우클릭 「챕터 추가」가
                                 바로 세우고, 챕터가 하나도 없으면 판 한가운데 [＋ 첫 챕터 만들기]가 선다. -->
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Static s:Ui.Keys_Hierarchy}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                    x:Name="FoldHierarchyButton"
                                    Content="‹"
                                    FontSize="12"
                                    Padding="7,0"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    ToolTip.Tip="{x:Static s:Ui.Board_CollapseHierarchyBoardGetsWider}" />
                            </Grid>
                        </Border>
                        <views:StoryHierarchy Grid.Row="1" x:Name="Hierarchy" />
                    </Grid>

                    <!-- 접힌 하이어아키 — 세로 띠 하나. 누르면 편다(HierarchyDock). -->
                    <Button x:Name="HierarchyStrip"
                            IsVisible="False"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Top"
                            Padding="0,6"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip.Tip="{x:Static s:Ui.Board_ExpandHierarchy}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="›" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <LayoutTransformControl>
                                <LayoutTransformControl.LayoutTransform>
                                    <RotateTransform Angle="90" />
                                </LayoutTransformControl.LayoutTransform>
                                <TextBlock Text="{x:Static s:Ui.Keys_Hierarchy}" FontSize="11" Opacity="0.7" />
                            </LayoutTransformControl>
                        </StackPanel>
                    </Button>
                </Panel>
            </Border>

            <GridSplitter Grid.Column="1"
                          x:Name="HierarchySplitter"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 초점이 바뀌어도 판을 스크롤하지 않는다 — 글 칸을 반영하면 판을 다시 그리고 새 칸에 초점을 돌려주는데,
                 그 칸은 아직 자리가 잡히기 전이라 판이 엉뚱한 자리로 튄다. 판 안에서 초점을 받는 칸은 사람이 지금
                 보고 누른 칸이라 따로 데려올 까닭이 없다. 쓰는 커서를 따라가는 스크롤은 그대로다. -->
            <ScrollViewer Grid.Column="2"
                          x:Name="GraphScroll"
                          BringIntoViewOnFocusChange="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <!-- 배율은 레이아웃 변환이다 — 스크롤 범위가 확대/축소를 그대로 따라온다. -->
                <!-- 크기는 코드비하인드의 CanvasWidth/Height가 정한다 — 미니맵 배율과
                     한 곳에서 맞아야 하므로 여기에 숫자를 적지 않는다. -->
                <!-- 배경은 반드시 실제 브러시여야 한다: FluentTheme에는 ThemeBackgroundBrush가
                     없어 null이 되고, 배경 없는 Canvas는 빈 곳 클릭이 히트되지 않아
                     범위 선택·간선 선택 해제가 조용히 죽는다. Transparent도 히트는 된다. -->
                <!-- 판은 왼위에 붙는다 — 배율을 줄여 판이 화면보다 작아지면 배율 칸이 화면만큼 늘어나 판을 가운데로 밀었다(12%에서 위가 비고
                     10%에서는 판이 화면 밖으로 나가 아무것도 안 보였다 · 미니맵은 판이 왼위에 있다고 셈한다). 2026-11-18 소유자 보고. -->
                <LayoutTransformControl x:Name="ZoomHost" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas x:Name="GraphCanvas"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent" />
                </LayoutTransformControl>
            </ScrollViewer>

            <!-- 빈 판의 첫걸음 — 챕터가 하나도 없으면 판 한가운데에 선다(2026-11-18 소유자 · first-chapter F1). [＋ 에피소드]는 활성 판이 없어
                 꺼져 있고, 하이어아키 우클릭 「챕터 추가」는 알 길이 없었다. 누르면 그 「챕터 추가」와 같다(셸 — 장면 · 에피소드와 함께).
                 저장된 프로젝트가 없으면(처음 켰을 때) 챕터를 만들 수 없다 — 그때는 [열기…] · [새 프로젝트…]가 선다(배선은 셸: File 메뉴와
                 같은 길 · 2026-11-19 소유자 · usability UX35 — ⛔ 전에는 [＋ 첫 챕터 만들기]가 서서 눌러도 아래 상태줄에만 말이 떴다). -->
            <StackPanel Grid.Column="2"
                        x:Name="EmptyBoardPanel"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock x:Name="EmptyBoardText"
                           Text="{x:Static s:Ui.Board_NoChaptersYet}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Opacity="0.55" />
                <Button x:Name="FirstChapterButton"
                        Content="{x:Static s:Ui.Board_CreateFirstChapter}"
                        HorizontalAlignment="Center"
                        Padding="16,6"
                        ToolTip.Tip="{x:Static s:Ui.Board_CreatesWithSceneAndOne}" />
                <StackPanel x:Name="EmptyProjectButtons"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="10"
                            IsVisible="False">
                    <Button x:Name="EmptyOpenProjectButton"
                            Content="{x:Static s:Ui.Main_Open}"
                            Padding="16,6"
                            ToolTip.Tip="{x:Static s:Ui.Board_OpensProjectYouReceivedChoose}" />
                    <Button x:Name="EmptyNewProjectButton"
                            Content="{x:Static s:Ui.Main_NewProject2}"
                            Padding="16,6"
                            ToolTip.Tip="{x:Static s:Ui.Board_StartsFreshChooseEmptyFolder}" />
                </StackPanel>
            </StackPanel>

            <!-- 미니맵 — 우측 하단에 전체 맵과 현재 배율. 클릭·드래그로 뷰포트 이동. 판과 같은 칸에 겹쳐 선다.
                 설정 창 「기타」에서 감추면 지도 · 배율 단추 · 바탕 · 테두리가 걷히고 지금 배율(「28%」)만 연한 회색 글자로 남는다 — 누를 것이 없어 눌림도
                 받지 않는다(밑의 카드 글 칸을 그대로 누른다 · 2026-11-25 소유자 — 「글을 쓰다보니 저게 텍스트 박스에 걸려서 걸리적 거린다」 · ApplyShowMinimap).
                 ⛔ 그 전에는 지도만 걷고 [전체 · 50 · 100 · 150] 배율 줄이 바탕째 남았다(2026-11-18 · side-fold K3). -->
            <Border Grid.Column="2"
                    x:Name="MinimapPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,18,18"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#66808080"
                    Background="#F2F6F7FA">
                <StackPanel>
                    <Canvas x:Name="MinimapCanvas"
                            Width="180"
                            Height="120"
                            ClipToBounds="True"
                            Background="Transparent"
                            Cursor="Hand" />
                    <!-- 전체 보기·배율 프리셋 — 큰 판의 길찾기. -->
                    <Border x:Name="ZoomBar" BorderBrush="#33808080" BorderThickness="0,1,0,0" Padding="4,2">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*">
                            <Button Grid.Column="0" x:Name="FitAllButton" Content="{x:Static s:Ui.Board_FitAll}"
                                    FontSize="9" Padding="5,1" Margin="0,0,3,0" />
                            <Button Grid.Column="1" x:Name="Zoom50Button" Content="50"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="2" x:Name="Zoom100Button" Content="100"
                                    FontSize="9" Padding="4,1" Margin="0,0,2,0" />
                            <Button Grid.Column="3" x:Name="Zoom150Button" Content="150"
                                    FontSize="9" Padding="4,1" />
                            <TextBlock Grid.Column="4"
                                       x:Name="ZoomText"
                                       Margin="6,0,0,0"
                                       FontSize="10"
                                       Opacity="0.7"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Text="100%" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 찾기 띠 — Ctrl+F(맥은 ⌘F)로 판 오른쪽 위에 선다(2026-11-25 소유자 — 「대본의 그래프뷰에서 Ctrl+F 기능이 있으면 좋겠다」 · GraphEditorView.Find).
                 대사 · 화자 · 카드 제목을 찾아 그 카드로 간다(접힌 장면 · 챕터면 펼친다). Enter = 다음 · Shift+Enter = 앞 · Esc = 닫고 찾은 자리에서 쓰기. -->
            <Border Grid.Column="2"
                    x:Name="FindBar"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,18,0"
                    Padding="6,4"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="#66808080"
                    Background="#F7F8FAFC">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="FindBox"
                             Width="220"
                             FontSize="12"
                             MinHeight="0"
                             Padding="6,3"
                             VerticalContentAlignment="Center"
                             PlaceholderText="{x:Static s:Ui.Board_FindDialogueSpeakersTitles}" />
                    <TextBlock x:Name="FindCount"
                               FontSize="11"
                               Opacity="0.7"
                               MinWidth="44"
                               TextAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button x:Name="FindPrevButton" Content="▲" FontSize="10" Padding="6,2" Focusable="False"
                            ToolTip.Tip="{x:Static s:Ui.Board_PreviousShiftEnter}" />
                    <Button x:Name="FindNextButton" Content="▼" FontSize="10" Padding="6,2" Focusable="False"
                            ToolTip.Tip="{x:Static s:Ui.Board_NextEnter}" />
                    <Button x:Name="FindCloseButton" Content="✕" FontSize="10" Padding="6,2" Focusable="False"
                            ToolTip.Tip="{x:Static s:Ui.Board_CloseEscKeepWritingRight}" />
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3"
                          x:Name="SideSplitter"
                          ResizeDirection="Columns"
                          Background="{DynamicResource ThemeBorderLowBrush}" />

            <!-- 우측 기둥 = 탭 셋 — 인스펙터 · 화자 · 조건 및 스탯([구성] 탭과 같은 차례 · 같은 이름 — 2026-11-18 소유자 · side-tabs V3).
                 ⛔ 그 전에는 인스펙터 하나였고 화자 · 조건 · 스탯은 하이어아키의 프로젝트 · 챕터 줄을 골라야만 섰다.
                 내용(대사 편집기 · 요약 · 화자 목록 · 조건과 스탯)은 셸이 짓는다 — 이 뷰는 자리만 내준다.
                 고르면 그것을 보이는 탭으로 간다: 프로젝트 → 화자, 챕터 → 조건 및 스탯(챕터 이름 칸이 그 탭 맨 위다 — chapter-pick Y1,
                 ⛔ 그 전에는 인스펙터 머리였다 — M3), 그 밖 → 인스펙터.
                 콤보로 챕터를 바꾸는 것은 탭을 바꾸지 않는다. -->
            <Border Grid.Column="4"
                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                    BorderThickness="1,0,0,0">
                <Panel>
                <Panel x:Name="SideOpen">
                <TabControl x:Name="SideTabs" Padding="0">
                    <TabControl.Styles>
                        <!-- 탭 글은 작게 — 테마 기본(큰 글 · 48 높이)은 [구성] · [대본] 탭과 같은 무게라 기둥 안에서는 너무 크다. -->
                        <Style Selector="TabItem">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="10,2" />
                        </Style>
                    </TabControl.Styles>

                    <TabItem x:Name="InspectorTabItem" Header="{x:Static s:Ui.Board_Inspector}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="1">
                                    <!-- 장면 요약의 머리는 이름 칸이다(2026-11-18 소유자 — 에피소드의 이름 칸처럼 여기서 고친다). 그 밖에는 이름 글 —
                                         챕터 이름 칸은 「조건 및 스탯」 탭 맨 위다(chapter-pick Y1 · ⛔ 그 전에는 챕터 요약의 머리도 이름 칸이었다). -->
                                    <TextBox x:Name="InspectorNameBox" FontWeight="SemiBold" IsVisible="False" />
                                    <TextBlock x:Name="InspectorTitle" Text="{x:Static s:Ui.Board_Inspector}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="InspectorSubtitle"
                                               FontSize="11"
                                               Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="SideHost" />
                        </Grid>
                    </TabItem>

                    <!-- 화자 — 프로젝트 전체의 캐스트. 이름을 더하고 고치고 지운다(writer-fields W3). 캐릭터 키는 [구성] 탭이다. -->
                    <TabItem x:Name="SpeakerTabItem" Header="{x:Static s:Ui.Board_Speakers}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{x:Static s:Ui.Board_SpeakersForWholeProject}" FontWeight="SemiBold" />
                                    <views:GuideLine Full="{x:Static s:Ui.Board_EveryChapterUsesSameList}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="SpeakerHost" />
                        </Grid>
                    </TabItem>

                    <!-- 조건 및 스탯 — 챕터 단위다. 머리가 그것을 말하고, 오른쪽 위 작은 드롭다운이 지금 챕터(활성 판 — 툴바 콤보와 같은 값)를
                         비춘다. 고르면 툴바 콤보로 고른 것과 같다(2026-11-18 소유자). 스탯 표(대사에 붙여 쓰기) · 조건 이름(writer-fields W4). -->
                    <TabItem x:Name="ConditionTabItem" Header="{x:Static s:Ui.Board_ConditionsStats}">
                        <Grid RowDefinitions="Auto,*">
                            <Border Grid.Row="0"
                                    Padding="10,6"
                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static s:Ui.Board_ConditionsStatsForThisChapter}" FontWeight="SemiBold" />
                                        <views:GuideLine Full="{x:Static s:Ui.Board_UsedOnlyInThisChapter}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              x:Name="ConditionChapterCombo"
                                              FontSize="11"
                                              MinHeight="24"
                                              MaxWidth="150"
                                              Padding="6,0"
                                              Margin="8,0,0,0"
                                              VerticalAlignment="Top"
                                              ToolTip.Tip="{x:Static s:Ui.Board_ChapterThisTabShowsFollows}" />
                                </Grid>
                            </Border>
                            <ContentControl Grid.Row="1" x:Name="ConditionHost" />
                        </Grid>
                    </TabItem>
                </TabControl>
                    <!-- 기둥 접기 — 탭 줄 오른쪽 끝(2026-11-18 소유자 · side-fold K1). 하이어아키의 「‹」와 같은 손짓이다(ColumnDock). -->
                    <Button x:Name="FoldSideButton"
                            Content="›"
                            FontSize="12"
                            Padding="7,0"
                            Margin="0,5,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            ToolTip.Tip="{x:Static s:Ui.Board_CollapseSidePanelInspectorSpeakers}" />
                </Panel>

                <!-- 접힌 오른쪽 기둥 — 세로 띠 하나. 누르면 편다(ColumnDock). -->
                <Button x:Name="SideStrip"
                        IsVisible="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Top"
                        Padding="0,6"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip.Tip="{x:Static s:Ui.Board_ExpandSidePanel}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="‹" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <LayoutTransformControl>
                            <LayoutTransformControl.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </LayoutTransformControl.LayoutTransform>
                            <TextBlock Text="{x:Static s:Ui.Board_InspectorSpeakersConditionsStats}" FontSize="11" Opacity="0.7" />
                        </LayoutTransformControl>
                    </StackPanel>
                </Button>
                </Panel>
            </Border>
        </Grid>

        <!-- 아래 띠는 <b>지금 무슨 일이 벌어지는지</b>만 말한다.
             늘 서 있는 조작법 설명은 두지 않는다 — 손이 이미 아는 것을 화면이 매번 다시
             일러 주면 정작 무언가를 말해야 할 때 눈에 안 띈다.

             말하는 것은 둘: 포트를 끄는 중의 안내(어디에 놓으면 되는가·빈 곳은 끊기)와
             고른 간선의 정체다. 할 말이 없으면 띠 자체가 접힌다 — 빈 칸이 서 있으면
             그것도 소음이다. 여닫는 문은 SetHint 하나다. -->
        <Border Grid.Row="2"
                x:Name="HintBar"
                Padding="10,6"
                IsVisible="False"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock x:Name="HintText"
                       FontSize="11"
                       Opacity="0.7"
                       TextWrapping="Wrap" />
        </Border>
        <!-- 초점 받이 — 카드 머리나 빈 판을 누르면 카드 글 칸의 초점을 여기로 옮긴다. 카드와 판은
             초점을 받지 않아서, 옮기지 않으면 글 칸이 초점을 쥔 채 다른 노드가 골라지고 쓴 글이 안 들어간다.
             판 자체를 초점 받는 것으로 만들면 누를 때마다 초점이 옮겨 선택지 문구 칸까지 닫히므로 따로 둔다. -->
        <Border x:Name="WritingFocusSink" Grid.Row="0" Width="0" Height="0" Focusable="True"
                IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" />
    </Grid>
</UserControl>
