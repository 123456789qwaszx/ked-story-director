<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>Vn.App</RootNamespace>
    <!-- 작가에게 보이는 이름(2026-11-19 · writer-app WA4) — 실행 파일은 StoryDirector(.exe), 탐색기 · 작업 관리자에는
         「스토리 디렉터」. 프로젝트 · 네임스페이스(Vn.App)는 안의 이름이라 그대로다. 창 제목의 이름은 Services/AppIdentity.cs. -->
    <AssemblyName>StoryDirector</AssemblyName>
    <AssemblyTitle>스토리 디렉터</AssemblyTitle>
    <Product>스토리 디렉터</Product>
    <!-- 실행 파일의 아이콘(Windows 탐색기 · 작업 표시줄). 창의 아이콘은 App.axaml.cs가 같은 파일로 단다. 그림을 바꾸려면 원본
         Assets/app-icon.png를 갈고 tools/make-app-icons.py로 다시 굽는다(.ico · 맥의 .icns) — WA5. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 판 번호 — 꾸러미를 구울 때 정한다(`-p:Version=0.1.0` · publish-windows.ps1 · publish-macos.sh · .github/workflows/release.yml). 손으로 짓는
         빌드는 0.0.0이고 창 제목에 「개발판」으로 선다(Services/AppIdentity.cs · writer-release WR2). -->
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <!-- 테마가 싣는 글꼴(themes) — 「파스텔 하늘」의 Pretendard · Jua Story Director · 나눔고딕(SIL OFL 1.1 — THIRD-PARTY-NOTICES.txt의 B-4 · B-2 · B-3)과 아이콘 글꼴. 테마 폴더 안에 둔다. -->
    <AvaloniaResource Include="Themes\**\Fonts\*.ttf" />
  </ItemGroup>

  <!-- 화면 문구 표(2026-11-25 · english-ui E1) — Strings/Ui.resx(한국어 · 기본)와 Ui.en.resx(영어). 빌드가 표에서
       Vn.App.Strings.Ui 클래스를 짓는다(키마다 속성 — 없는 키를 쓰면 빌드가 멈춘다). 영어 표는 en/StoryDirector.resources.dll로 따로 구워진다. -->
  <ItemGroup>
    <EmbeddedResource Update="Strings\Ui.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedClassName>Ui</StronglyTypedClassName>
      <StronglyTypedNamespace>Vn.App.Strings</StronglyTypedNamespace>
      <StronglyTypedFileName>$(IntermediateOutputPath)Ui.g.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vn.Authoring\Vn.Authoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vn.App.Tests" />
  </ItemGroup>

  <!--
    배포는 exe 하나로 — 비개발자에게 넘기기 위해.

    <b>디버그 심볼은 배포물에 넣지 않는다.</b> SkiaSharp·HarfBuzz의 네이티브 .pdb가
    합쳐서 100MB인데, 그건 exe(78MB)보다 크면서 쓰는 사람에게는 아무 소용이 없다.
    `DebugType=none`은 우리 어셈블리만 다스리므로 패키지가 딸려 보낸 것은 여기서 턴다.
  -->
  <Target Name="StripPublishedSymbols" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbol Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>

    <Delete Files="@(PublishedSymbol)" />
  </Target>
</Project>
