<Project Sdk="Microsoft.NET.Sdk">

  <!--
    진행 규칙 코어 — 런타임 정본에서 복사 반입한 한 벌.

    이 폴더의 주인은 여기가 아니다. 현재 실질 정본은
    `ked-presentation-runtime/server_DB@d53cc2f`의 `Assets/Scripts/Ked.Progression`이다.
    이 프로젝트 파일과 Unity 메타/테스트를 제외한 순수 C# 소스를 통째로 반입한다.

    반입은 파일이 아니라 **한 번의 통째 교체**여야 한다. 일부 파일만 옛 모양으로 남으면
    이를테면 `cleared:` 조건을 쓴 챕터가 **저작에서 통과하고 게임에서 로드 실패**하는데,
    이 사본에는 테스트가 없어 그 어긋남을 아무도 못 본다.

    **여기서 고치지 않는다.** 규칙이 갈리면 툴의 도달성 증명과 게임의 실제 플레이가
    다른 답을 낸다 — 이 코어가 존재하는 이유가 정확히 그것을 없애는 것이다.
    고칠 것이 있으면 런타임 담당자에게 넘기고, 정본이 바뀐 뒤 다시 반입한다.

    사본이라는 사실을 숨기지 않는다. 방침은 **패키지로 가는 것**이고, 그때 이
    폴더와 csproj는 참조 한 줄로 사라진다. 그때까지의 규율 — **복사의 단위는 파일이 아니라 한 번의 반입이다.**

    아래 두 줄은 유니티(.NET Standard 2.1 · C# 9)로 되돌아갈 수 없는 코드가 이쪽에서 자라는 것을
    컴파일러가 막는 안전핀이다.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Ked.Progression</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
