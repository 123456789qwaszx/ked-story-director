        "primaryLocale": "ko-KR",
        "sourceRevision": 1,
        "sourceContentHash": "5265695482CB75B7305072C17A79F20619871A80C300E005BCC84BA2E8B5EBD0",
        "lines": [
          {
            "id": "ln_jfze1fzb",
            "revision": 2
