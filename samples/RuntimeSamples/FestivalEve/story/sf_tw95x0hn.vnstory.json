            "revision": 1
          }
        ],
        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_jfze1fzb": {
                "speaker": "시구레",
                "text": "마른 칸은 살리고, 빈 칸만 스티커로 채워요."
              },
              "ln_rbxvmjp0": {
                "speaker": "하린",
                "text": "지금 요령은 {stat(\"요령\")}점이야. 방금 그 선택지가 올린 거지."
              },
              "ln_j1v81kqe": {
                "speaker": "하린",
                "text": "대사는 스탯을 읽기만 해. 바꾸는 건 진행 선택지뿐이야."
              },
              "ln_fih4v3qp": {
                "speaker": "시구레",
                "text": "아직 같은 장면이라, 되감기(R)로 돌아가면 방금 선택도 다시 고를 수 있어요."
              }
            }
          }
        ]
      },
