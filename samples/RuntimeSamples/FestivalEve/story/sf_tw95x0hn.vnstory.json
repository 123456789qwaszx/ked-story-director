          },
          {
            "id": "ln_g2hh953n",
            "revision": 1
          },
          {
            "id": "ln_9k3krs99",
            "revision": 1
          }
        ],
        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_ngjwdzsb": {
                "speaker": "하린",
                "text": "저녁의 교무실 앞. 장면이 바뀌었어."
              },
              "ln_f70g3xzg": {
                "speaker": "시구레",
                "text": "교실 장면은 확정돼서 저장됐어요. 되감기로는 거기까지 돌아가지 않아요."
              },
              "ln_hv7zzi8m": {
                "speaker": "하린",
                "text": "대신 대사 기록에서 교실 장면의 대사를 누르면, 거기서 새 회차로 갈라져."
              },
              "ln_hb0cdhkt": {
                "speaker": "시구레",
                "text": "메뉴에서 저장하면 지금 이 자리를 슬롯에 남길 수 있어요."
              },
              "ln_mmj0m4fe": {
                "speaker": "하린",
                "text": "내일 축제, 잘 되겠지?"
              },
              "ln_g2hh953n": {
                "speaker": "시구레",
                "text": "그럼요. 오늘은 여기까지예요."
              },
              "ln_9k3krs99": {
                "text": "캐릭터 퇴장"
              }
            }
          }
        ]
      },
      "episodeMark": "Festival_Staffroom",
      "lines": [
