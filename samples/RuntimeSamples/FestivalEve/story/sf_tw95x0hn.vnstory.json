        ],
        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_kdy67tc8": {
                "speaker": "하린",
                "text": "좋아, 처음부터 다시. 붓부터 새로 빨아 올게."
              },
              "ln_2ibajvnq": {
                "speaker": "시구레",
                "text": "지금 성실은 {stat(\"성실\")}점이에요. 방금 그 선택지가 올린 거예요."
              },
              "ln_prrx0d33": {
                "speaker": "시구레",
                "text": "대사는 스탯을 읽기만 해요. 바꾸는 건 진행 선택지뿐이고요."
              },
              "ln_068q2fi1": {
                "speaker": "하린",
                "text": "아직 같은 장면이라, 되감기(R)로 돌아가면 방금 선택도 다시 고를 수 있어."
              },
              "ln_hebn9452": {
                "text": "{stat(\"성실\")}"
              },
              "ln_cx9af36k": {
                "text": "{stat(\"성실\")}"
              },
              "ln_tgcnm3hu": {
                "text": "정말이야?"
              },
              "ln_upe9pfwb": {
                "text": "안 믿겨"
              },
              "ln_pi8vat7c": {
                "text": "거짓말"
              },
              "ln_pbpqpvrj": {
                "text": "ㅂ123"
              },
              "ln_gq2p56yp": {
                "text": "ㄱㄱ"
              }
            }
          }
        ]
