        "locales": [
          {
            "locale": "ko-KR",
            "entries": {
              "ln_yfg43av8": {
                "speaker": "시구레",
                "text": "이제 교무실에 가서 간판 검사를 받아야 해요."
              },
              "ln_jb5v7as4": {
                "speaker": "시구레",
                "text": "이번 선택지에는 조건이 달려 있어요. 안 맞으면 숨거나, 잠긴 채로 이유가 보여요."
              }
            }
          }
        ]
      },
      "episodeMark": "Festival_Wrapup",
